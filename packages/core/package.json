{
  "name": "@ekwo-ai/core",
  "version": "0.8.0",
  "description": "TypeScript row types and a typed Supabase client for the Ekwo OS accounting schema.",
  "keywords": ["accounting", "supabase", "postgres", "pcmn", "pcg", "bookkeeping", "ekwo"],
  "license": "AGPL-3.0-only",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Ekwo-ai/ekwo-os.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/Ekwo-ai/ekwo-os/issues" },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "ekwo": { "schemaMin": "0.8.0" },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ekwo-ai/camt053": "^0.8.0",
    "@ekwo-ai/cfonb120": "^0.8.0",
    "@ekwo-ai/coda": "^0.8.0",
    "@ekwo-ai/fec": "^0.8.0",
    "@ekwo-ai/journal-items": "^0.8.0",
    "@ekwo-ai/journal-report": "^0.8.0",
    "@ekwo-ai/trial-balance": "^0.8.0",
    "@ekwo-ai/xaf": "^0.8.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": { "optional": true }
  }
}
