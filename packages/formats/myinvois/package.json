{
  "name": "@ekwo-ai/myinvois",
  "version": "0.22.0",
  "description": "Malaysia's MyInvois e-Invoice (LHDNM) in TypeScript: the UBL 2.1 document of an invoice, credit note, debit note or refund note, the supplier's or self-billed, in JSON or XML, from a posted document, with every rule of the SDK it breaks named by LHDNM's own error code. Zero dependencies.",
  "keywords": [
    "myinvois",
    "lhdn",
    "lhdnm",
    "e-invoice",
    "einvoice",
    "malaysia",
    "ubl",
    "ubl-2.1",
    "self-billed",
    "invoice",
    "json",
    "xml"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/myinvois#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/myinvois"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "codelists": "node scripts/build-codelists.mjs",
    "codelists:check": "node scripts/build-codelists.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "xmllint-wasm": "^5.3.0"
  }
}
