{
  "name": "@ekwo-ai/journal-report",
  "version": "0.8.0",
  "description": "Reads a journal report or a general ledger detail saved as CSV — date, journal number, account code, debit, credit — with the chart of accounts and the contacts exported beside it, into plain objects in TypeScript: amounts as decimal strings, and what does not add up. Zero dependencies.",
  "keywords": [
    "journal-report",
    "general-ledger",
    "csv",
    "accounting",
    "bookkeeping",
    "migration",
    "import",
    "parser"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/journal-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/journal-report"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
