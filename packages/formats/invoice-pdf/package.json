{
  "name": "@ekwo-ai/invoice-pdf",
  "version": "0.12.0",
  "description": "The visual PDF of an invoice or a credit note, in TypeScript, from the rows a set of books publishes: A4 or Letter, multi-page, any language Intl knows, Noto Sans embedded. Ready to carry a Factur-X XML.",
  "keywords": [
    "invoice",
    "credit-note",
    "pdf",
    "invoice-pdf",
    "factur-x",
    "zugferd",
    "pdf-a3",
    "noto-sans",
    "intl"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/invoice-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/invoice-pdf"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "licenses",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts": "node scripts/embed-fonts.mjs",
    "examples": "tsx examples/generate.ts",
    "verapdf": "node scripts/verapdf.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@ekwo-ai/factur-x": "^0.12.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
