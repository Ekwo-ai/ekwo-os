{
  "name": "@ekwo-ai/verifactu",
  "version": "0.24.0",
  "description": "Spain's VERI*FACTU invoicing records (registro de facturación de alta and de anulación) in TypeScript: the XML of the AEAT schema, the chained SHA-256 fingerprint and the URL of the QR code, with every rule the record breaks named by the AEAT's own error code. Zero dependencies.",
  "keywords": [
    "verifactu",
    "veri-factu",
    "aeat",
    "sif",
    "registro-de-facturacion",
    "huella",
    "hash",
    "qr",
    "spain",
    "invoice",
    "xml"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/verifactu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/verifactu"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "xmllint-wasm": "^5.3.0"
  }
}
