{
  "name": "@ekwo-ai/csv-statement",
  "version": "0.25.0",
  "description": "Reads a bank, payment-account or card statement exported as CSV, described by a column profile the caller gives, into plain objects in TypeScript: account, balances and lines, amounts as decimal strings, and what does not add up. One reader for every bank, no bank written in it. Zero dependencies.",
  "keywords": [
    "csv",
    "bank-statement",
    "card-statement",
    "payment-account",
    "reconciliation",
    "column-profile",
    "parser"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/csv-statement#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/csv-statement"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
