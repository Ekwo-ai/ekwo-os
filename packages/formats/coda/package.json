{
  "name": "@ekwo-ai/coda",
  "version": "0.6.0",
  "description": "Reads a CODA coded statement of account (Febelfin, version 2) into plain objects in TypeScript: account, balances and lines, amounts as decimal strings, and what does not add up. Zero dependencies.",
  "keywords": [
    "coda",
    "febelfin",
    "bank-statement",
    "coded-statement-of-account",
    "reconciliation",
    "structured-communication",
    "fixed-width",
    "parser"
  ],
  "license": "MIT",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os/tree/main/packages/formats/coda#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/formats/coda"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
