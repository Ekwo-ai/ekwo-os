{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "inherit": "IFRS-SME",
  "statements": [
    {
      "code": "DM-IFRS-SME-SFP",
      "kind": "balance_sheet",
      "framework": "IFRS-SME",
      "name": "Statement of financial position",
      "legal_reference": "The Companies Act and the Income Tax Act of Dominica were not opened for this pack, so no section of either is cited, and none is asserted to prescribe a layout. This statement follows the presentation of IFRS for SMEs (International Accounting Standards Board), section 4: current and non-current assets and liabilities, with equity shown beside them; that is a choice of this pack, not a text the country imposes, and a company reporting under full IFRS presents the same balance sheet with different notes. The numbering and the ranges each line reads are original to this pack. The VAT collected (2100 to 2199) is a current tax liability; the VAT recoverable sits with the receivables (1170 to 1172), unnetted. Cash flows and changes in equity are separate statements this pack does not model",
      "result_in_progress": "alone",
      "source": "iasb-ifrs-sme"
    },
    {
      "code": "DM-IFRS-SME-IS",
      "kind": "income_statement",
      "framework": "IFRS-SME",
      "name": "Income statement",
      "legal_reference": "Same choice as the statement of financial position: the income statement is presented in the manner of IFRS for SMEs, section 5, with the expenses collapsed to cost of sales, other operating expenses and depreciation. No Dominica text read prescribes it. The corporate income tax charge (6470) falls in other operating expenses; the Income Tax Act was not opened and the tax is not modelled",
      "source": "iasb-ifrs-sme"
    }
  ],
  "overrides": [
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "A-NC-FIX",
      "name": "Property, plant and equipment"
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "add": {
        "code": "A-NC-INT",
        "parent": "A-NC",
        "name": "Goodwill and other intangible assets",
        "sequence": 15,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1800",
            "code_to": "1899"
          }
        ]
      }
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "A-NC",
      "plus": [
        "A-NC-FIX",
        "A-NC-INT",
        "A-NC-OTH"
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "A-C-REC",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1100",
          "code_to": "1199"
        }
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "add": {
        "code": "A-C-INV",
        "parent": "A-C",
        "name": "Inventories",
        "sequence": 45,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1200",
            "code_to": "1299"
          }
        ]
      }
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "A-C-OTH",
      "name": "Other current assets",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1300",
          "code_to": "1399"
        }
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "add": {
        "code": "A-C-PRE",
        "parent": "A-C",
        "name": "Prepayments and deposits paid",
        "sequence": 55,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1400",
            "code_to": "1499"
          }
        ]
      }
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "A-C",
      "plus": [
        "A-C-REC",
        "A-C-INV",
        "A-C-OTH",
        "A-C-PRE",
        "A-C-CASH"
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "E-CAP",
      "name": "Share capital and reserves"
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "E-RESULT",
      "name": "Profit or loss for the year, not yet allocated"
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "L-C-PAY",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2000",
          "code_to": "2059"
        }
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "add": {
        "code": "L-C-TAX",
        "parent": "L-C",
        "name": "Current tax liabilities, including VAT collected",
        "sequence": 135,
        "sign": -1,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "2060",
            "code_to": "2069",
            "sequence": 10
          },
          {
            "kind": "code_range",
            "code_from": "2100",
            "code_to": "2199",
            "sequence": 20
          }
        ]
      }
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
          "sequence": 20
        }
      ]
    },
    {
      "statement": "DM-IFRS-SME-SFP",
      "line": "L-C",
      "plus": [
        "L-C-PAY",
        "L-C-TAX",
        "L-C-OTH"
      ]
    },
    {
      "statement": "DM-IFRS-SME-IS",
      "line": "OPEX",
      "name": "Administrative and other operating expenses"
