{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "BN-BDAS-BS",
      "kind": "balance_sheet",
      "framework": "BDAS",
      "name": "Balance sheet",
      "legal_reference": "Brunei Darussalam Accounting Standards for Non-Public Interest Entities (BDAS NON-PIE), BDAS 1 (Presentation of Financial Statements), paragraphs 1.1 and 1.16 to 1.21: a complete set of financial statements comprises a balance sheet, an income statement, accounting policies and explanatory notes, and a cash flow statement; the balance sheet presents current and non-current assets and current and non-current liabilities as separate classifications, and its face includes, where applicable, property, plant and equipment, intangible assets, financial assets, inventories, trade and other receivables, tax assets, cash and cash equivalents, trade and other payables, tax liabilities, provisions, non-current liabilities, issued capital and reserves (paragraph 1.19). BDAS NON-PIE has applied since 1 January 2018 to entities without public accountability (Brunei Darussalam Accounting Standards Council, Frequently Asked Questions on BDAS); an entity with public accountability reports under full IFRS since 1 January 2014 (Notice No. 1/2014) and a non-public interest entity may choose IFRS. The numbering below and the ranges each line reads are original to this pack: neither the Income Tax Act nor BDAS prescribes a chart of accounts, so the blocks are this pack's own. This pack does not carry the cash flow statement BDAS 18 also requires; see the README.",
      "lines": [
        {
          "code": "A-NC-FIX",
          "parent": "A-NC",
          "name": "Property, plant and equipment",
          "sequence": 10,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1600",
              "code_to": "1799"
            }
          ]
        },
        {
          "code": "A-NC-INT",
          "parent": "A-NC",
          "name": "Goodwill and other intangible assets",
          "sequence": 20,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1800",
              "code_to": "1899"
            }
          ]
        },
        {
          "code": "A-NC-OTH",
          "parent": "A-NC",
          "name": "Other non-current assets",
          "sequence": 30,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1900",
              "code_to": "1999"
            }
          ]
        },
        {
          "code": "A-NC",
          "name": "Non-current assets",
          "sequence": 40,
          "is_total": true,
          "plus": [
            "A-NC-FIX",
            "A-NC-INT",
            "A-NC-OTH"
          ]
        },
        {
          "code": "A-C-REC",
          "parent": "A-C",
          "name": "Trade and other receivables",
          "sequence": 50,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1100",
              "code_to": "1149",
              "sequence": 10
            },
            {
              "kind": "code_range",
              "code_from": "1170",
              "code_to": "1199",
              "sequence": 20
            }
          ]
        },
        {
          "code": "A-C-TAX",
          "parent": "A-C",
          "name": "Current tax assets",
          "sequence": 60,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1150",
              "code_to": "1169"
            }
          ]
        },
        {
          "code": "A-C-INV",
          "parent": "A-C",
          "name": "Inventories",
          "sequence": 70,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1200",
              "code_to": "1299"
            }
          ]
        },
        {
          "code": "A-C-OTH",
          "parent": "A-C",
          "name": "Other current assets",
          "sequence": 80,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1300",
              "code_to": "1399"
            }
          ]
        },
        {
          "code": "A-C-PRE",
          "parent": "A-C",
          "name": "Prepayments and deposits paid",
          "sequence": 90,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1400",
              "code_to": "1499"
            }
          ]
        },
        {
          "code": "A-C-CASH",
          "parent": "A-C",
          "name": "Cash and cash equivalents",
          "sequence": 100,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1000",
              "code_to": "1099"
            }
          ]
        },
        {
          "code": "A-C",
          "name": "Current assets",
          "sequence": 110,
          "is_total": true,
          "plus": [
            "A-C-REC",
            "A-C-TAX",
            "A-C-INV",
            "A-C-OTH",
            "A-C-PRE",
            "A-C-CASH"
          ]
        },
        {
          "code": "A-TOT",
          "name": "Total assets",
          "sequence": 120,
          "is_total": true,
          "plus": [
            "A-NC",
            "A-C"
          ]
        },
        {
          "code": "E-CAP",
          "parent": "E-TOT",
          "name": "Share capital and reserves",
          "sequence": 130,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3000",
              "code_to": "3199"
            }
          ]
        },
        {
          "code": "E-RET",
          "parent": "E-TOT",
          "name": "Retained earnings",
          "sequence": 140,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3200",
              "code_to": "3299"
            }
          ]
        },
        {
          "code": "E-RESULT",
          "parent": "E-TOT",
          "name": "Profit or loss for the year, not yet allocated",
          "sequence": 150,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "4000",
              "code_to": "4699",
              "sequence": 10
            },
            {
              "kind": "code_range",
              "code_from": "4700",
              "code_to": "4799",
              "sequence": 20
            },
            {
              "kind": "code_range",
              "code_from": "5000",
              "code_to": "5099",
              "sequence": 30
            },
            {
              "kind": "code_range",
              "code_from": "6000",
              "code_to": "6899",
              "sequence": 40
            }
          ]
        },
        {
          "code": "E-TOT",
          "name": "Total equity",
          "sequence": 160,
          "is_total": true,
          "plus": [
            "E-CAP",
            "E-RET",
            "E-RESULT"
          ]
        },
        {
          "code": "L-NC",
          "parent": "L-TOT",
          "name": "Non-current liabilities",
          "sequence": 170,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2300",
              "code_to": "2399"
            }
          ]
        },
        {
          "code": "L-C-PAY",
          "parent": "L-C",
          "name": "Trade and other payables",
          "sequence": 180,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2000",
              "code_to": "2059"
            }
          ]
        },
        {
          "code": "L-C-TAX",
          "parent": "L-C",
          "name": "Current tax liabilities",
          "sequence": 190,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2060",
              "code_to": "2069"
            }
          ]
        },
        {
          "code": "L-C-OTH",
          "parent": "L-C",
          "name": "Other current liabilities",
          "sequence": 200,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2070",
              "code_to": "2099",
              "sequence": 10
            },
            {
              "kind": "code_range",
              "code_from": "2200",
              "code_to": "2299",
              "sequence": 20
            }
          ]
        },
        {
          "code": "L-C",
          "name": "Current liabilities",
          "sequence": 210,
          "is_total": true,
          "plus": [
            "L-C-PAY",
            "L-C-TAX",
            "L-C-OTH"
          ]
        },
        {
          "code": "L-TOT",
          "name": "Total liabilities",
          "sequence": 220,
          "is_total": true,
          "plus": [
            "L-NC",
            "L-C"
          ]
        },
        {
          "code": "EL-TOT",
          "name": "Total equity and liabilities",
          "sequence": 230,
          "is_total": true,
          "plus": [
            "E-TOT",
            "L-TOT"
          ]
        }
      ]
    },
    {
      "code": "BN-BDAS-IS",
      "kind": "income_statement",
      "framework": "BDAS",
      "name": "Income statement",
      "legal_reference": "BDAS NON-PIE, BDAS 1, paragraphs 1.22 to 1.28: the face of the income statement includes, where applicable, revenue, finance costs, tax expense and profit or loss for the period, with further line items and subtotals where needed, and an analysis of expenses by nature or by function. BDAS NON-PIE presents an income statement and not a statement of comprehensive income (paragraph 1.1(b)). This pack classifies expenses by nature, which paragraph 1.26 permits, and shows finance costs and tax expense on their own lines. The numbering below is this pack's own.",
      "lines": [
        {
          "code": "REV",
          "name": "Revenue",
          "sequence": 10,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "4000",
              "code_to": "4699"
            }
          ]
        },
        {
          "code": "COST",
          "name": "Cost of sales",
          "sequence": 20,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5000",
              "code_to": "5099"
            }
          ]
        },
        {
          "code": "GROSS",
          "name": "Gross profit",
          "sequence": 30,
          "is_total": true,
          "plus": [
            "REV"
          ],
          "minus": [
            "COST"
          ]
        },
        {
          "code": "OTH-INC",
          "name": "Other income",
          "sequence": 40,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "4700",
              "code_to": "4799"
            }
          ]
        },
        {
          "code": "OPEX",
          "name": "Administrative and other operating expenses",
          "sequence": 50,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6000",
              "code_to": "6409",
              "sequence": 10
            },
            {
              "kind": "code_range",
              "code_from": "6430",
              "code_to": "6469",
              "sequence": 20
            },
            {
              "kind": "code_range",
              "code_from": "6490",
              "code_to": "6799",
              "sequence": 30
            }
          ]
        },
        {
          "code": "DEPR",
          "name": "Depreciation and amortisation",
          "sequence": 60,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6800",
              "code_to": "6899"
            }
          ]
        },
        {
          "code": "FIN",
          "name": "Finance costs",
          "sequence": 70,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6410",
              "code_to": "6429"
            }
          ]
        },
        {
          "code": "TAX",
          "name": "Tax expense",
          "sequence": 80,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6470",
              "code_to": "6489"
            }
          ]
        },
        {
          "code": "PROFIT",
          "name": "Profit (loss) for the year",
          "sequence": 90,
          "is_total": true,
          "plus": [
            "GROSS",
            "OTH-INC"
          ],
          "minus": [
            "OPEX",
            "DEPR",
            "FIN",
            "TAX"
          ]
        }
      ]
    }
  ]
}
