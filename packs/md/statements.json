        { "code": "090", "name": "Rezultatul din activitatea de investiții: profit (pierdere)", "sequence": 90, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "621", "sequence": 10 },
                    { "kind": "code_prefix", "code_from": "721", "sequence": 20 }],
          "legal_reference": "Forma nr. 2, rd. 090 (621-721) — venituri și cheltuieli din operațiuni cu active imobilizate, reunite pe un singur rând al formularului.", "source": "snc-prezentarea" },
        { "code": "100", "name": "Rezultatul din activitatea financiară: profit (pierdere)", "sequence": 100, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "622", "sequence": 10 },
                    { "kind": "code_prefix", "code_from": "722", "sequence": 20 }],
          "legal_reference": "Forma nr. 2, rd. 100 (622-722) — venituri și cheltuieli financiare, reunite pe un singur rând al formularului.", "source": "snc-prezentarea" },
        { "code": "110", "name": "Rezultatul din activitatea economico-financiară: profit (pierdere)", "sequence": 110, "is_total": true,
          "plus": ["080", "090", "100"], "legal_reference": "Forma nr. 2, rd. 110 (±rd.080±rd.090±rd.100).", "source": "snc-prezentarea" },
        { "code": "120", "name": "Rezultatul excepțional: profit (pierdere)", "sequence": 120, "sign": -1,
