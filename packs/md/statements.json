        { "code": "040", "name": "Alte venituri operaționale", "sequence": 40, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "612", "sequence": 10 },
                    { "kind": "code_prefix", "code_from": "613", "sequence": 20 },
                    { "kind": "code_prefix", "code_from": "616", "sequence": 30 },
                    { "kind": "code_prefix", "code_from": "617", "sequence": 40 },
                    { "kind": "code_prefix", "code_from": "618", "sequence": 50 }] },
        { "code": "050", "name": "Cheltuieli comerciale", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "712", "sequence": 10 }] },
        { "code": "060", "name": "Cheltuieli generale și administrative", "sequence": 60, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "713", "sequence": 10 }] },
        { "code": "070", "name": "Alte cheltuieli operaționale", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "714", "sequence": 10 },
