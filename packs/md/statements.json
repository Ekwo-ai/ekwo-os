    {
      "code": "MD-SNC-IS",
      "kind": "income_statement",
      "framework": "MD-SNC-5",
      "name": "Raportul de profit și pierderi",
      "legal_reference": "S.N.C. 5 „Prezentarea situațiilor financiare”, anexa nr. 2 — Forma nr. 2, Raportul de profit și pierderi, în varianta pe funcții (cheltuieli clasificate în costul vânzărilor, cheltuieli de distribuire, cheltuieli administrative și alte cheltuieli operaționale). Veniturile și cheltuielile din conturile 613, 616-618 și, respectiv, 715-718, care nu figurau pe un rând distinct al primei redacții a formularului consultate, sunt reluate împreună cu «alte venituri operaționale» (rd. 040) și «alte cheltuieli operaționale» (rd. 070) — a se vedea README.md.",
      "source": "snc-prezentarea",
      "lines": [
        { "code": "010", "name": "Venituri din vînzări", "sequence": 10, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "611", "sequence": 10 }] },
