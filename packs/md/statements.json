        { "code": "140", "name": "Cheltuieli (economii) privind impozitul pe venit", "sequence": 140, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "731", "sequence": 10 }] },
        { "code": "150", "name": "Profit net (pierdere)", "sequence": 150, "is_total": true,
          "plus": ["130"], "minus": ["140"], "legal_reference": "Forma nr. 2, rd. 150 (±rd.130±rd.140).", "source": "snc-prezentarea" }
