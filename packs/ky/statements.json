{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "inherit": "IFRS-SME",
  "statements": [
    {
      "code": "KY-IFRS-SME-SFP",
      "kind": "balance_sheet",
      "framework": "IFRS-SME",
      "name": "Statement of financial position",
      "legal_reference": "Companies Act (2026 Revision), section 59(1) and (2) requires every company to keep proper books of account — contracts and invoices included — and deems them not proper unless they give a true and fair view of the company's affairs and explain its transactions; it prescribes no financial-statement format and no accounting framework. This statement follows the presentation of IFRS for SMEs (IASB): current and non-current assets and liabilities, equity, with the result for the year shown as its own unallocated line until closing. The line numbering and the ranges each line reads are original to this pack, because no legal chart exists to number against. See the README.",
      "result_in_progress": "alone"
    },
    {
      "code": "KY-IFRS-SME-IS",
      "kind": "income_statement",
      "framework": "IFRS-SME",
      "name": "Income statement",
      "legal_reference": "Companies Act (2026 Revision), section 59 prescribes no income statement format; the Cayman Islands imposes no income, corporate or other direct tax, so this statement has no tax expense line. It presents revenue, cost of sales, other income, operating expenses and depreciation in the single-statement shape IFRS for SMEs (IASB) permits an entity with no other comprehensive income. The line numbering is original to this pack."
    }
  ],
  "overrides": [
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "A-NC-FIX",
      "name": "Property, plant and equipment"
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "add": {
        "code": "A-NC-INT",
        "parent": "A-NC",
        "name": "Goodwill and other intangible assets",
        "sequence": 15,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1800",
            "code_to": "1899"
          }
        ]
      }
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "A-NC",
      "plus": [
        "A-NC-FIX",
        "A-NC-INT",
        "A-NC-OTH"
      ]
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "A-C-REC",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1100",
          "code_to": "1199"
        }
      ]
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "add": {
        "code": "A-C-INV",
        "parent": "A-C",
        "name": "Inventories",
        "sequence": 45,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1200",
            "code_to": "1299"
          }
        ]
      }
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "A-C-OTH",
      "name": "Other current assets",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1300",
          "code_to": "1399"
        }
      ]
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "add": {
        "code": "A-C-PRE",
        "parent": "A-C",
        "name": "Prepayments and deposits paid",
        "sequence": 55,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1400",
            "code_to": "1499"
          }
        ]
      }
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "A-C",
      "plus": [
        "A-C-REC",
        "A-C-INV",
        "A-C-OTH",
        "A-C-PRE",
        "A-C-CASH"
      ]
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "E-CAP",
      "name": "Share capital and reserves"
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "E-RET",
      "name": "Retained profits"
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "E-RESULT",
      "name": "Profit or loss for the year, not yet allocated"
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "L-C-PAY",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2000",
          "code_to": "2069"
        }
      ]
    },
    {
      "statement": "KY-IFRS-SME-SFP",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
          "sequence": 20
        }
      ]
    },
    {
      "statement": "KY-IFRS-SME-IS",
      "line": "OPEX",
      "name": "Administrative and other operating expenses"
    },
    {
      "statement": "KY-IFRS-SME-IS",
      "line": "PROFIT",
      "name": "Profit (loss) for the year"
    }
  ]
}
