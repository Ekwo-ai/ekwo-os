{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "inherit": "IFRS-SME",
  "statements": [
    {
      "code": "NR-IFRS-SFP",
      "kind": "balance_sheet",
      "framework": "IFRS",
      "name": "Statement of financial position",
      "legal_reference": "Nauru prescribes no statement layout that this pack's research found. The Nauru Revenue Office's key-dates page (consulted 7 November 2026) sets a tax year of 1 July to 30 June, and the Business Tax Act 2016 is the income tax in force, but this pack's research did not open a text that fixes the accounting framework a Nauruan company must apply, the financial year its accounts cover, or the content of its annual accounts: the Corporations Act (a 1972 Act appears on the legislation database; the existence of a 2021 Act could not be confirmed) was not read. The lines follow the minimum line items of IAS 1 Presentation of Financial Statements, paragraph 54, with current and non-current assets and liabilities presented separately (paragraph 60); the numbering and the account ranges are original to this pack. Which IFRS regime, if any, applies is the first thing a local reviewer should check.",
      "result_in_progress": "alone",
      "source": "nro-key-dates"
    },
    {
      "code": "NR-IFRS-IS",
      "kind": "income_statement",
      "framework": "IFRS",
      "name": "Statement of profit or loss",
      "legal_reference": "Presented as a separate statement of profit or loss, with expenses classified by function in outline (cost of sales, then operating expenses) in the manner of IAS 1 paragraphs 81A and 99-103, as the Income Tax Law (Law No. 24 of 2018), articles 6 and 12, point to international accounting standards without prescribing a layout. Other comprehensive income is not modelled: no revaluation or similar account is carried, so the profit for the year is the whole result. IFRS 18, which replaces IAS 1 for annual periods beginning on or after 1 January 2027, is not modelled. The numbering is original to this pack.",
      "source": "nro-key-dates"
    }
  ],
  "overrides": [
    {
      "statement": "NR-IFRS-SFP",
      "line": "A-NC-FIX",
      "name": "Property, plant and equipment"
    },
    {
      "statement": "NR-IFRS-SFP",
      "add": {
        "code": "A-NC-INT",
        "parent": "A-NC",
        "name": "Goodwill and other intangible assets",
        "sequence": 15,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1800",
            "code_to": "1899"
          }
        ]
      }
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "A-NC",
      "plus": [
        "A-NC-FIX",
        "A-NC-INT",
        "A-NC-OTH"
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "A-C-REC",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1100",
          "code_to": "1199"
        }
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "add": {
        "code": "A-C-INV",
        "parent": "A-C",
        "name": "Inventories",
        "sequence": 45,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1200",
            "code_to": "1299"
          }
        ]
      }
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "A-C-OTH",
      "name": "Other current assets",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1300",
          "code_to": "1399"
        }
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "add": {
        "code": "A-C-PRE",
        "parent": "A-C",
        "name": "Prepayments and deposits paid",
        "sequence": 55,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1400",
            "code_to": "1499"
          }
        ]
      }
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "A-C",
      "plus": [
        "A-C-REC",
        "A-C-INV",
        "A-C-OTH",
        "A-C-PRE",
        "A-C-CASH"
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "E-CAP",
      "name": "Share capital and reserves"
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "E-RESULT",
      "name": "Profit for the year"
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "L-C-PAY",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2000",
          "code_to": "2059"
        }
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "add": {
        "code": "L-C-TAX",
        "parent": "L-C",
        "name": "Current tax liabilities",
        "sequence": 135,
        "sign": -1,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "2060",
            "code_to": "2069"
          }
        ]
      }
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
          "sequence": 20
        }
      ]
    },
    {
      "statement": "NR-IFRS-SFP",
      "line": "L-C",
      "plus": [
        "L-C-PAY",
        "L-C-TAX",
        "L-C-OTH"
      ]
    },
    {
      "statement": "NR-IFRS-IS",
      "line": "OPEX",
      "name": "Administrative and other operating expenses"
    },
    {
      "statement": "NR-IFRS-IS",
      "add": {
        "code": "PBT",
        "name": "Profit (loss) before tax",
        "sequence": 65,
        "is_total": true,
        "plus": [
          "GROSS",
          "OTH-INC"
        ],
        "minus": [
          "OPEX",
          "DEPR"
        ]
      }
    },
    {
      "statement": "NR-IFRS-IS",
      "add": {
        "code": "TAX",
        "name": "Business profits tax expense",
        "sequence": 67,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "6470",
            "code_to": "6474",
            "sequence": 10
          },
          {
            "kind": "account_code",
            "code_from": "6480",
            "sequence": 20
          }
        ]
      }
    },
    {
      "statement": "NR-IFRS-IS",
      "line": "PROFIT",
      "name": "Profit (loss) for the year",
      "plus": [
        "PBT"
      ],
      "minus": [
        "TAX"
      ]
    }
  ]
}
