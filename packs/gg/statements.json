            {
              "kind": "code_range",
              "code_from": "1200",
              "code_to": "1210"
            }
          ]
        },
        {
          "code": "C.IV",
          "parent": "C",
          "name": "Cash at bank and in hand",
          "sequence": 90,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
