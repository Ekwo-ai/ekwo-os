{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "GG-FRS102-1A-BS",
      "kind": "balance_sheet",
      "framework": "UK-FRS102",
      "name": "Balance sheet — FRS 102 Section 1A, Format 1",
      "legal_reference": "FRS 102 The Financial Reporting Standard applicable in the UK and Republic of Ireland, Section 1A (Small Entities), is the framework this statement follows: the Companies (Guernsey) Law, 2008 requires accounts including a balance sheet that give a true and fair view and state the generally accepted accounting principles adopted (Walkers, consulted 2026-10-10), and names no format; UK GAAP is one of the principles a Guernsey company may declare. The layout is the one Section 1A shows for small entities, the Format 1 balance sheet (fixed assets, current assets, creditors due within and after one year, provisions, capital and reserves) in its summarised form. It is a layout borrowed from the United Kingdom standard, not a format Guernsey law imposes, and the lines are the pack's own groupings of its original chart. Line K.IV carries the year's result not yet closed to retained earnings, so that the statement ties to the cent on an open year. The text of the Law itself could not be opened; see the README.",
      "source": "frs-102",
      "lines": [
        {
          "code": "A",
          "name": "Called up share capital not paid",
          "sequence": 10,
          "sign": 1,
          "rules": [
            {
              "kind": "account_code",
              "code_from": "0000"
            }
          ]
        },
        {
          "code": "B.I",
          "parent": "B",
          "name": "Intangible assets",
          "sequence": 20,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "0010",
              "code_to": "0041"
            }
          ]
        },
        {
          "code": "B.II",
          "parent": "B",
          "name": "Tangible assets",
          "sequence": 30,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "0100",
              "code_to": "0161"
            }
          ]
        },
        {
          "code": "B.III",
          "parent": "B",
          "name": "Investments",
          "sequence": 40,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "0200",
              "code_to": "0230"
            }
          ]
        },
        {
          "code": "B",
          "name": "Fixed assets",
          "sequence": 50,
          "is_total": true,
          "plus": [
            "B.I",
            "B.II",
            "B.III"
          ]
        },
        {
