          "sign": -1,
          "rules": [
            {
              "kind": "account_code",
              "code_from": "2550"
            }
          ]
        },
        {
          "code": "TL",
          "name": "Total liabilities",
          "sequence": 60,
          "is_total": true,
          "plus": [
            "CL",
            "NCL"
          ]
        },
        {
          "code": "NA",
          "name": "Net assets",
          "sequence": 70,
          "is_total": true,
          "plus": [
            "TA"
          ],
          "minus": [
            "TL"
          ]
        },
        {
          "code": "EQ",
          "name": "Equity",
          "sequence": 80,
          "is_total": true,
          "plus": [
            "EQ.1",
            "EQ.2",
            "EQ.3"
          ]
        },
        {
          "code": "EQ.1",
          "name": "Share capital",
          "sequence": 81,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3000",
              "code_to": "3010"
            }
          ]
        },
        {
          "code": "EQ.2",
          "name": "Other reserves",
          "sequence": 82,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3100",
              "code_to": "3110"
            }
          ]
        },
        {
          "code": "EQ.3",
          "name": "Retained earnings",
          "sequence": 83,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3200",
              "code_to": "3210"
