    {
      "code": "KE-ICPAK-IS",
      "kind": "income_statement",
      "framework": "IFRS-SME",
      "name": "Profit and loss account",
      "valid_from": "2015-09-15",
      "legal_reference": "Companies Act (Cap. 486), s. 638(2)(a)(ii) \u2014 an individual financial statement comprises a profit and loss account; s. 638(2)(b)(ii) \u2014 it gives a true and fair view of the profit or loss of the company for the financial year. ICPAK's illustrative statement aggregates expenses by nature, which these lines follow.",
      "source": "companies-act-2015",
      "lines": [
        {
          "code": "1",
          "name": "Revenue",
          "sequence": 10,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "4000",
              "code_to": "4030"
