{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "MY-BS",
      "kind": "balance_sheet",
      "framework": "MY-ORIGINAL",
      "taxonomy": null,
      "name": "Statement of financial position",
      "legal_reference": "Malaysia prescribes no line items of its own that this session could read as a primary, openly served text: Companies Act 2016, section 245 requires a company's financial statements to comply with the approved accounting standards MASB issues — MFRS, converging with IFRS, or MPERS, converging with the IFRS for SMEs Accounting Standard — and this session could not open either standard's own paragraphs (they are served to registered users; see the pack's README, \"Sources\"). This statement is original: it groups this chart's own accounts by the code ranges accounts.csv gives them — current and non-current, receivables and payables split from other balances — the same classification MFRS 101 and Section 4 of MPERS use, without transcribing either standard's own line items or their paragraph numbering.",
      "source": null,
      "lines": [
        { "code": "CA-CASH", "parent": "CA", "name": "Cash and cash equivalents", "sequence": 10,
          "rules": [ { "kind": "code_range", "code_from": "1000", "code_to": "1040" } ] },
        { "code": "CA-REC", "parent": "CA", "name": "Trade and other receivables", "sequence": 20,
          "rules": [
            { "kind": "code_range", "code_from": "1100", "code_to": "1140" },
            { "kind": "account_code", "code_from": "2990", "side": "debit" }
          ] },
        { "code": "CA-TAX", "parent": "CA", "name": "Sales Tax and Service Tax refundable by RMCD", "sequence": 30,
          "rules": [ { "kind": "account_code", "code_from": "1155" } ] },
        { "code": "CA-STAFF", "parent": "CA", "name": "Advances to staff", "sequence": 40,
          "rules": [ { "kind": "account_code", "code_from": "1160" } ] },
        { "code": "CA-INV", "parent": "CA", "name": "Inventories", "sequence": 50,
          "rules": [ { "kind": "code_range", "code_from": "1200", "code_to": "1230" } ] },
        { "code": "CA-STI", "parent": "CA", "name": "Short-term investments", "sequence": 60,
          "rules": [ { "kind": "account_code", "code_from": "1300" } ] },
        { "code": "CA-ITAX", "parent": "CA", "name": "Income tax recoverable", "sequence": 70,
          "rules": [ { "kind": "account_code", "code_from": "1350" } ] },
        { "code": "CA-PREP", "parent": "CA", "name": "Prepayments and accrued income", "sequence": 80,
          "rules": [ { "kind": "code_range", "code_from": "1400", "code_to": "1410" } ] },
        { "code": "CA", "name": "Current assets", "sequence": 90, "is_total": true,
          "plus": ["CA-CASH", "CA-REC", "CA-TAX", "CA-STAFF", "CA-INV", "CA-STI", "CA-ITAX", "CA-PREP"] },

        { "code": "NCA-PPE", "parent": "NCA", "name": "Property, plant and equipment", "sequence": 100,
          "rules": [ { "kind": "code_range", "code_from": "1600", "code_to": "1671" } ] },
        { "code": "NCA-INVPROP", "parent": "NCA", "name": "Investment property", "sequence": 110,
          "rules": [ { "kind": "account_code", "code_from": "1700" } ] },
        { "code": "NCA-INTANG", "parent": "NCA", "name": "Intangible assets and goodwill", "sequence": 120,
          "rules": [ { "kind": "code_range", "code_from": "1750", "code_to": "1760" } ] },
        { "code": "NCA-ASSOC", "parent": "NCA", "name": "Investments in associates and joint ventures", "sequence": 130,
          "rules": [ { "kind": "code_range", "code_from": "1800", "code_to": "1810" } ] },
        { "code": "NCA-FIN", "parent": "NCA", "name": "Long-term financial assets and deposits", "sequence": 140,
          "rules": [ { "kind": "code_range", "code_from": "1830", "code_to": "1840" } ] },
        { "code": "NCA-DTA", "parent": "NCA", "name": "Deferred tax assets", "sequence": 150,
          "rules": [ { "kind": "account_code", "code_from": "1900" } ] },
        { "code": "NCA", "name": "Non-current assets", "sequence": 160, "is_total": true,
          "plus": ["NCA-PPE", "NCA-INVPROP", "NCA-INTANG", "NCA-ASSOC", "NCA-FIN", "NCA-DTA"] },

        { "code": "TA", "name": "Total assets", "sequence": 170, "is_total": true, "plus": ["CA", "NCA"] },

        { "code": "CL-PAY", "parent": "CL", "name": "Trade payables", "sequence": 180, "sign": -1,
          "rules": [
            { "kind": "account_code", "code_from": "2000" },
            { "kind": "account_code", "code_from": "2990", "side": "credit" }
          ] },
        { "code": "CL-OTH", "parent": "CL", "name": "Other payables and accruals", "sequence": 190, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2010", "code_to": "2040" } ] },
        { "code": "CL-TAXP", "parent": "CL", "name": "Sales Tax and Service Tax payable — output", "sequence": 200, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2100", "code_to": "2102" } ] },
        { "code": "CL-TAXSETTLE", "parent": "CL", "name": "Sales Tax and Service Tax payable to RMCD — net of a filed return", "sequence": 210, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "2110" } ] },
        { "code": "CL-STAT", "parent": "CL", "name": "Statutory and payroll liabilities", "sequence": 220, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2150", "code_to": "2190" } ] },
        { "code": "CL-FIN", "parent": "CL", "name": "Borrowings and other current financial liabilities", "sequence": 230, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2200", "code_to": "2250" } ] },
        { "code": "CL-ITAX", "parent": "CL", "name": "Income tax payable", "sequence": 240, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "2300" } ] },
        { "code": "CL-PROV", "parent": "CL", "name": "Provisions — current", "sequence": 250, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2350", "code_to": "2360" } ] },
        { "code": "CL", "name": "Current liabilities", "sequence": 260, "is_total": true,
          "plus": ["CL-PAY", "CL-OTH", "CL-TAXP", "CL-TAXSETTLE", "CL-STAT", "CL-FIN", "CL-ITAX", "CL-PROV"] },

        { "code": "NCL-FIN", "parent": "NCL", "name": "Borrowings — non-current portion", "sequence": 270, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "2400", "code_to": "2430" } ] },
        { "code": "NCL-DTAX", "parent": "NCL", "name": "Deferred tax liabilities", "sequence": 280, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "2500" } ] },
        { "code": "NCL-PROV", "parent": "NCL", "name": "Provisions — non-current", "sequence": 290, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "2550" } ] },
        { "code": "NCL", "name": "Non-current liabilities", "sequence": 300, "is_total": true,
          "plus": ["NCL-FIN", "NCL-DTAX", "NCL-PROV"] },

        { "code": "TL", "name": "Total liabilities", "sequence": 310, "is_total": true, "plus": ["CL", "NCL"] },

        { "code": "EQ-CAP", "parent": "EQ", "name": "Share capital", "sequence": 320, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3000", "code_to": "3010" } ] },
        { "code": "EQ-RES", "parent": "EQ", "name": "Other reserves", "sequence": 330, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3100", "code_to": "3110" } ] },
        { "code": "EQ-RET", "parent": "EQ", "name": "Retained earnings", "sequence": 340, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3200", "code_to": "3210" } ] },
        { "code": "EQ", "name": "Total equity", "sequence": 350, "is_total": true,
          "plus": ["EQ-CAP", "EQ-RES", "EQ-RET"] },

        { "code": "TLE", "name": "Total liabilities and equity", "sequence": 360, "is_total": true,
          "plus": ["TL", "EQ"] }
      ]
    },
    {
      "code": "MY-IS",
      "kind": "income_statement",
      "framework": "MY-ORIGINAL",
      "taxonomy": null,
      "name": "Statement of profit or loss",
      "legal_reference": "As MY-BS: original, grouped by the code ranges accounts.csv gives this chart's revenue, cost and expense accounts, by nature.",
      "source": null,
      "lines": [
        { "code": "REV", "name": "Revenue", "sequence": 10, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4000", "code_to": "4030" } ] },
        { "code": "COGS", "name": "Cost of sales", "sequence": 20,
          "rules": [ { "kind": "code_range", "code_from": "5000", "code_to": "5100" } ] },
        { "code": "GROSS", "name": "Gross profit", "sequence": 30, "is_total": true,
          "plus": ["REV"], "minus": ["COGS"] },
        { "code": "OTH-INC", "name": "Other income", "sequence": 40, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4500", "code_to": "4790" } ] },
        { "code": "OPEX", "name": "Administrative and other operating expenses", "sequence": 50,
          "rules": [
            { "kind": "code_range", "code_from": "6000", "code_to": "6080" },
            { "kind": "code_range", "code_from": "6300", "code_to": "6990" }
          ] },
        { "code": "DEPR", "name": "Depreciation and amortisation", "sequence": 60,
          "rules": [ { "kind": "code_range", "code_from": "6200", "code_to": "6220" } ] },
        { "code": "FIN", "name": "Finance costs", "sequence": 70,
          "rules": [ { "kind": "code_range", "code_from": "7000", "code_to": "7030" } ] },
        { "code": "PRETAX", "name": "Profit before tax", "sequence": 80, "is_total": true,
          "plus": ["GROSS", "OTH-INC"], "minus": ["OPEX", "DEPR", "FIN"] },
        { "code": "TAX", "name": "Income tax expense", "sequence": 90,
          "rules": [ { "kind": "code_range", "code_from": "8000", "code_to": "8020" } ] },
        { "code": "PROFIT", "name": "Profit for the year", "sequence": 100, "is_total": true,
          "plus": ["PRETAX"], "minus": ["TAX"] }
      ]
    }
  ]
}
