{
  "$schema": "https://ekwo.ai/schemas/pack/1.json",
  "statements": [
    {
      "code": "EC-NIIF-ESF",
      "kind": "balance_sheet",
      "framework": "EC-NIIF",
      "name": "Estado de situación financiera",
      "legal_reference": "Ley de Régimen Tributario Interno, art. 20 y 21 — los estados financieros se elaboran tomando en cuenta los principios contables de general aceptación (en la práctica actual, las NIIF completas o las NIIF para las PYMES adoptadas por la Superintendencia de Compañías, Valores y Seguros) y sirven de base tanto para la declaración de impuestos como para su presentación societaria. No existe un formato único obligatorio para toda sociedad: este paquete presenta un estado de situación financiera resumido, por clasificación NIIF de corriente y no corriente",
      "source": "lrti-contabilidad",
      "lines": [
        { "code": "EFEC", "parent": "AC", "name": "Efectivo y equivalentes de efectivo", "sequence": 10, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.01" }] },
        { "code": "FIN", "parent": "AC", "name": "Activos financieros", "sequence": 20, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.02" }] },
        { "code": "CXC", "parent": "AC", "name": "Cuentas y documentos por cobrar comerciales", "sequence": 30, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.03" }] },
        { "code": "OCXC", "parent": "AC", "name": "Otras cuentas por cobrar", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.04" }] },
        { "code": "INV", "parent": "AC", "name": "Inventarios", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.05" }] },
        { "code": "ANT", "parent": "AC", "name": "Servicios y otros pagos anticipados", "sequence": 60, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.06" }] },
        { "code": "IMPC", "parent": "AC", "name": "Activos por impuestos corrientes", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.1.07" }] },
        { "code": "AC", "parent": "ACT", "name": "Total activo corriente", "sequence": 80, "is_total": true,
          "plus": ["EFEC", "FIN", "CXC", "OCXC", "INV", "ANT", "IMPC"] },

        { "code": "PPE", "parent": "ANC", "name": "Propiedades, planta y equipo", "sequence": 90, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.2.01" }] },
        { "code": "INT", "parent": "ANC", "name": "Activos intangibles", "sequence": 100, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "1.2.02" }] },
        { "code": "ANC", "parent": "ACT", "name": "Total activo no corriente", "sequence": 110, "is_total": true,
          "plus": ["PPE", "INT"] },

        { "code": "ACT", "parent": null, "name": "Total activo", "sequence": 120, "is_total": true,
          "plus": ["AC", "ANC"] },

        { "code": "CXP", "parent": "PC", "name": "Cuentas y documentos por pagar", "sequence": 130, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.1.01" }] },
        { "code": "OFCP", "parent": "PC", "name": "Obligaciones con instituciones financieras", "sequence": 140, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.1.02" }] },
        { "code": "ADMT", "parent": "PC", "name": "Otras obligaciones con la administración tributaria", "sequence": 150, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.1.03" }] },
        { "code": "IVAP", "parent": "PC", "name": "Impuesto al valor agregado", "sequence": 160, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.1.04" }] },
        { "code": "OCXP", "parent": "PC", "name": "Otras cuentas por pagar", "sequence": 170, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.1.05" }] },
        { "code": "PC", "parent": "PAS", "name": "Total pasivo corriente", "sequence": 180, "is_total": true,
          "plus": ["CXP", "OFCP", "ADMT", "IVAP", "OCXP"] },

        { "code": "OFLP", "parent": "PNC", "name": "Obligaciones con instituciones financieras a largo plazo", "sequence": 190, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "2.2.01" }] },
        { "code": "PNC", "parent": "PAS", "name": "Total pasivo no corriente", "sequence": 200, "is_total": true,
          "plus": ["OFLP"] },

        { "code": "PAS", "parent": null, "name": "Total pasivo", "sequence": 210, "is_total": true,
          "plus": ["PC", "PNC"] },

        { "code": "CAP", "parent": "PAT", "name": "Capital", "sequence": 220, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "3.1" }] },
        { "code": "RES", "parent": "PAT", "name": "Reservas", "sequence": 230, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "3.3" }] },
        { "code": "RACU", "parent": "PAT", "name": "Resultados acumulados", "sequence": 240, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "3.6" }] },
        { "code": "REJE", "parent": "PAT", "name": "Resultados del ejercicio", "sequence": 250, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "3.7" }] },
        { "code": "PAT", "parent": null, "name": "Total patrimonio neto", "sequence": 260, "is_total": true,
          "plus": ["CAP", "RES", "RACU", "REJE"] }
      ]
    },
    {
      "code": "EC-NIIF-ER",
      "kind": "income_statement",
      "framework": "EC-NIIF",
      "name": "Estado de resultado integral",
      "legal_reference": "Ley de Régimen Tributario Interno, art. 20 y 21, en los mismos términos que EC-NIIF-ESF. Este paquete presenta un estado de resultados resumido, por naturaleza de la clasificación NIIF de ingresos, costos y gastos",
      "source": "lrti-contabilidad",
      "lines": [
        { "code": "ING", "parent": "UN", "name": "Ingresos de actividades ordinarias", "sequence": 10, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "4.1" }] },
        { "code": "OIN", "parent": "UN", "name": "Otros ingresos", "sequence": 20, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "4.2" }] },
        { "code": "COV", "parent": "UN", "name": "Costo de ventas", "sequence": 30, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "5.1" }] },
        { "code": "GAD", "parent": "UN", "name": "Gastos de administración", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "5.2" }] },
        { "code": "GVE", "parent": "UN", "name": "Gastos de venta", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "5.3" }] },
        { "code": "GFI", "parent": "UN", "name": "Gastos financieros", "sequence": 60, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "5.4" }] },
        { "code": "GIR", "parent": "UN", "name": "Gasto por impuesto a la renta", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "5.5" }] },
        { "code": "UN", "parent": null, "name": "Ganancia (pérdida) neta del período", "sequence": 80, "is_total": true,
          "plus": ["ING", "OIN"], "minus": ["COV", "GAD", "GVE", "GFI", "GIR"] }
      ]
    }
  ]
}
