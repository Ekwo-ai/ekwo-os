    {
      "code": "XK-IFRS-IS",
      "kind": "income_statement",
      "framework": "IFRS-SME",
      "name": "Pasqyra e të ardhurave gjithëpërfshirëse",
      "legal_reference": "Ligji Nr. 06/L-032 për Kontabilitet, Raportim Financiar dhe Auditim, neni 8; IFRS for SMEs, seksioni 5 — zërat minimalë të pasqyrës së të ardhurave gjithëpërfshirëse. Struktura këtu është sipas diapazoneve të kodeve të llogarive të vetë këtij paketi, jo sipas kodeve të një formulari zyrtar që nuk ekziston — shih README.md.",
      "source": "ligji-kontabiliteti",
      "lines": [
        {
          "code": "REV",
