{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "LA-BS",
      "kind": "balance_sheet",
      "framework": "LFRS (IFRS for SMEs)",
      "name": "Statement of financial position (balance sheet)",
      "valid_from": "2014-07-01",
      "legal_reference": "IFRS for SMEs, section 4 (statement of financial position) and section 5 (statement of comprehensive income), on which the Lao financial reporting standards for non-public interest entities rest (Law on Accounting, amended 2013). The lines are the items those sections list, grouped over this pack's own chart; the official Lao forms were not read. See README.md.",
      "source": "ifrs-sme",
      "result_in_progress": "combined",
      "result_in_progress_name": "Result of the current financial year",
      "lines": [
        {
          "code": "AS-CASH",
          "name": "Cash",
          "sequence": 10,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1100",
              "code_to": "1299"
            }
          ]
        },
        {
          "code": "AS-STINV",
          "name": "Short-term investments",
          "sequence": 20,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1300",
              "code_to": "1399"
            }
          ]
        },
        {
          "code": "AS-REC",
          "name": "Accounts and notes receivable",
          "sequence": 30,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1400",
              "code_to": "1499"
            }
          ]
        },
        {
          "code": "AS-OREC",
          "name": "Other receivables, advances and recoverable VAT",
          "sequence": 40,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1500",
              "code_to": "1599"
            }
          ]
        },
        {
          "code": "AS-INV",
          "name": "Inventories",
          "sequence": 50,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1600",
              "code_to": "1699"
            }
          ]
        },
        {
          "code": "AS-OCA",
          "name": "Prepaid expenses and other current assets",
          "sequence": 60,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "1700",
              "code_to": "1799"
            }
          ]
        },
        {
          "code": "AS-CA-TOTAL",
          "name": "Total current assets",
          "sequence": 70,
          "is_total": true,
          "plus": [
            "AS-CASH",
            "AS-STINV",
            "AS-REC",
            "AS-OREC",
            "AS-INV",
            "AS-OCA"
          ]
        },
        {
          "code": "AS-PPE",
          "name": "Property, plant and equipment, net",
          "sequence": 80,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2100",
              "code_to": "2199"
            }
          ]
        },
        {
          "code": "AS-ONCA",
          "name": "Other non-current assets",
          "sequence": 90,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2200",
              "code_to": "2899"
            }
          ]
        },
        {
          "code": "AS-INTANG",
          "name": "Intangible assets, net",
          "sequence": 100,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "2900",
              "code_to": "2999"
            }
          ]
        },
        {
          "code": "AS-NCA-TOTAL",
          "name": "Total non-current assets",
          "sequence": 110,
          "is_total": true,
          "plus": [
            "AS-PPE",
            "AS-ONCA",
            "AS-INTANG"
          ]
        },
        {
          "code": "AS-TOTAL",
          "name": "Total assets",
          "sequence": 120,
          "is_total": true,
          "plus": [
            "AS-CA-TOTAL",
            "AS-NCA-TOTAL"
          ]
        },
        {
          "code": "EQ-SHARE",
          "name": "Share capital",
          "sequence": 130,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5100",
              "code_to": "5199"
            }
          ]
        },
        {
          "code": "EQ-APIC",
          "name": "Additional paid-in capital",
          "sequence": 140,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5200",
              "code_to": "5299"
            }
          ]
        },
        {
          "code": "EQ-RETAINED",
          "name": "Retained earnings",
          "sequence": 150,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5300",
              "code_to": "5399"
            }
          ]
        },
        {
          "code": "EQ-RESERVE",
          "name": "Reserve capital",
          "sequence": 160,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5400",
              "code_to": "5499"
            }
          ]
        },
        {
          "code": "EQ-SUMMARY",
          "name": "Income summary (closing account)",
          "sequence": 170,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "5900",
              "code_to": "5999"
            }
          ]
        },
        {
          "code": "EQ-TOTAL",
          "name": "Total equity",
          "sequence": 180,
          "is_total": true,
          "plus": [
            "EQ-SHARE",
            "EQ-APIC",
            "EQ-RETAINED",
            "EQ-RESERVE",
            "EQ-SUMMARY"
          ]
        },
        {
          "code": "LI-PAY",
          "name": "Accounts and notes payable",
          "sequence": 190,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3100",
              "code_to": "3199"
            }
          ]
        },
        {
          "code": "LI-ADV",
          "name": "Advances received",
          "sequence": 200,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3200",
              "code_to": "3299"
            }
          ]
        },
        {
          "code": "LI-DEBT",
          "name": "Short-term loans and borrowings",
          "sequence": 210,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3300",
              "code_to": "3399"
            }
          ]
        },
        {
          "code": "LI-TAX",
          "name": "Taxes payable",
          "sequence": 220,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3400",
              "code_to": "3499"
            }
          ]
        },
        {
          "code": "LI-ACCR",
          "name": "Accrued liabilities",
          "sequence": 230,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3500",
              "code_to": "3599"
            }
          ]
        },
        {
          "code": "LI-OTHER",
          "name": "Other current liabilities",
          "sequence": 240,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3600",
              "code_to": "3699"
            }
          ]
        },
        {
          "code": "LI-PROV",
          "name": "Provisions",
          "sequence": 250,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "3700",
              "code_to": "3799"
            }
          ]
        },
        {
          "code": "LI-CL-TOTAL",
          "name": "Total current liabilities",
          "sequence": 260,
          "is_total": true,
          "plus": [
            "LI-PAY",
            "LI-ADV",
            "LI-DEBT",
            "LI-TAX",
            "LI-ACCR",
            "LI-OTHER",
            "LI-PROV"
          ]
        },
        {
          "code": "LI-LT",
          "name": "Non-current liabilities",
          "sequence": 270,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "4000",
              "code_to": "4999"
            }
          ]
        },
        {
          "code": "LI-NCL-TOTAL",
          "name": "Total non-current liabilities",
          "sequence": 280,
          "is_total": true,
          "plus": [
            "LI-LT"
          ]
        },
        {
          "code": "EQLI-TOTAL",
          "name": "Total equity and liabilities",
          "sequence": 290,
          "is_total": true,
          "plus": [
            "EQ-TOTAL",
            "LI-CL-TOTAL",
            "LI-NCL-TOTAL"
          ]
        }
      ]
    },
    {
      "code": "LA-IS",
      "kind": "income_statement",
      "framework": "LFRS (IFRS for SMEs)",
      "name": "Statement of comprehensive income (profit and loss)",
      "valid_from": "2014-07-01",
      "legal_reference": "IFRS for SMEs, section 4 (statement of financial position) and section 5 (statement of comprehensive income), on which the Lao financial reporting standards for non-public interest entities rest (Law on Accounting, amended 2013). The lines are the items those sections list, grouped over this pack's own chart; the official Lao forms were not read. See README.md.",
      "source": "ifrs-sme",
      "lines": [
        {
          "code": "IS-REV",
          "name": "Revenue, net of returns and discounts",
          "sequence": 10,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6100",
              "code_to": "6199"
            }
          ]
        },
        {
          "code": "IS-COGS",
          "name": "Cost of sales",
          "sequence": 20,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "7100",
              "code_to": "7299"
            }
          ]
        },
        {
          "code": "IS-GROSS",
          "name": "Gross profit",
          "sequence": 30,
          "is_total": true,
          "plus": [
            "IS-REV"
          ],
          "minus": [
            "IS-COGS"
          ]
        },
        {
          "code": "IS-SELL",
          "name": "Selling expenses",
          "sequence": 40,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "7500",
              "code_to": "7599"
            }
          ]
        },
        {
          "code": "IS-ADMIN",
          "name": "General and administrative expenses",
          "sequence": 50,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "8000",
              "code_to": "8999"
            }
          ]
        },
        {
          "code": "IS-OPINC",
          "name": "Other operating income",
          "sequence": 60,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "6200",
              "code_to": "6299"
            }
          ]
        },
        {
          "code": "IS-OPEXP",
          "name": "Other operating expenses",
          "sequence": 70,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "7600",
              "code_to": "7699"
            }
          ]
        },
        {
          "code": "IS-OPRESULT",
          "name": "Operating result",
          "sequence": 80,
          "is_total": true,
          "plus": [
            "IS-GROSS",
            "IS-OPINC"
          ],
          "minus": [
            "IS-SELL",
            "IS-ADMIN",
            "IS-OPEXP"
          ]
        },
        {
          "code": "IS-NONINC",
          "name": "Non-operating income",
          "sequence": 90,
          "sign": -1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "9100",
              "code_to": "9199"
            }
          ]
        },
        {
          "code": "IS-NONEXP",
          "name": "Non-operating expenses",
          "sequence": 100,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "9500",
              "code_to": "9599"
            }
          ]
        },
        {
          "code": "IS-PRETAX",
          "name": "Profit before tax",
          "sequence": 110,
          "is_total": true,
          "plus": [
            "IS-OPRESULT",
            "IS-NONINC"
          ],
          "minus": [
            "IS-NONEXP"
          ]
        },
        {
          "code": "IS-TAX",
          "name": "Income tax expense",
          "sequence": 120,
          "sign": 1,
          "rules": [
            {
              "kind": "code_range",
              "code_from": "9600",
              "code_to": "9699"
            }
          ]
        },
        {
          "code": "IS-NET",
          "name": "Net profit",
          "sequence": 130,
          "is_total": true,
          "plus": [
            "IS-PRETAX"
          ],
          "minus": [
            "IS-TAX"
          ]
        }
      ]
    }
  ]
}
