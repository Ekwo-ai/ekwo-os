{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "EG-EAS-SFP",
      "kind": "balance_sheet",
      "framework": "EG-EAS-SME",
      "taxonomy": null,
      "name": "قائمة المركز المالي — طبقًا لمعيار المنشآت الصغيرة والمتوسطة من معايير المحاسبة المصرية",
      "legal_reference": "The Minister of Investment issues Egyptian Accounting Standards (EAS) by ministerial decree published in the Official Gazette; EAS, current version issued in July 2015 and amended in 2019 and 2023, is close to IFRS Accounting Standards but not identical, and includes a dedicated set of requirements for small and medium-sized entities effective 1 January 2016 (IFRS Foundation, Jurisdictional Profile: Egypt). This pack's research could not open the Arabic decree text listing the small-and-medium-entities standard's own line items, so the lines below are built, as packs/ae and packs/sa build theirs where no country text could be opened, on the minimum line items the general IFRS for SMEs Accounting Standard, section 4, asks for — current and non-current apart. This is the first thing a reviewer familiar with the actual EAS text should check.",
      "source": "eas-ifrs-profile",
      "lines": [
        { "code": "CA", "name": "الأصول المتداولة", "sequence": 10, "is_total": true,
          "plus": ["CA.1","CA.2","CA.3","CA.4","CA.5","CA.6"] },
        { "code": "CA.1", "name": "النقدية وما في حكمها", "sequence": 20, "parent": "CA", "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1000", "code_to": "1040" }] },
        { "code": "CA.2", "name": "العملاء ومدينون آخرون", "sequence": 30, "parent": "CA", "sign": 1,
          "rules": [
            { "kind": "code_range", "code_from": "1100", "code_to": "1160" },
            { "kind": "account_code", "code_from": "2990", "side": "debit" }
          ],
          "legal_reference": "ضريبة القيمة المضافة المدخلات والرصيد المستحق من مصلحة الضرائب يعرضان هنا." },
        { "code": "CA.3", "name": "المخزون", "sequence": 40, "parent": "CA", "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1200", "code_to": "1230" }] },
        { "code": "CA.4", "name": "استثمارات قصيرة الأجل", "sequence": 50, "parent": "CA", "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "1300" }] },
        { "code": "CA.5", "name": "أصول ضريبية جارية", "sequence": 60, "parent": "CA", "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "1350" }] },
        { "code": "CA.6", "name": "مصروفات مدفوعة مقدمًا وإيرادات مستحقة", "sequence": 70, "parent": "CA", "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1400", "code_to": "1420" }] },
        { "code": "NCA", "name": "الأصول غير المتداولة", "sequence": 80, "is_total": true,
          "plus": ["NCA.1","NCA.2","NCA.3","NCA.4"] },
        { "code": "NCA.1", "name": "الأصول الثابتة", "sequence": 90, "parent": "NCA", "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1600", "code_to": "1650" }] },
        { "code": "NCA.2", "name": "استثمارات في شركات شقيقة وتابعة", "sequence": 100, "parent": "NCA", "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "1700" }] },
        { "code": "NCA.3", "name": "أصول غير متداولة أخرى", "sequence": 110, "parent": "NCA", "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "1710" }] },
        { "code": "NCA.4", "name": "الأصول غير الملموسة", "sequence": 120, "parent": "NCA", "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1730", "code_to": "1741" }] },
        { "code": "TA", "name": "إجمالي الأصول", "sequence": 130, "is_total": true, "plus": ["CA","NCA"] },
        { "code": "CL", "name": "الخصوم المتداولة", "sequence": 140, "is_total": true,
          "plus": ["CL.1","CL.2","CL.3","CL.4"] },
        { "code": "CL.1", "name": "الموردون ودائنون آخرون", "sequence": 150, "parent": "CL", "sign": -1,
          "rules": [
            { "kind": "code_range", "code_from": "2000", "code_to": "2060" },
            { "kind": "code_range", "code_from": "2100", "code_to": "2110" },
            { "kind": "account_code", "code_from": "2990", "side": "credit" }
          ],
          "legal_reference": "ضريبة القيمة المضافة المخرجات وضريبة الجدول تحت التحصيل والمستحق لمصلحة الضرائب تعرض هنا." },
        { "code": "CL.2", "name": "قروض قصيرة الأجل", "sequence": 160, "parent": "CL", "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "2200", "code_to": "2210" }] },
        { "code": "CL.3", "name": "خصوم ضريبية جارية", "sequence": 170, "parent": "CL", "sign": -1,
          "rules": [{ "kind": "account_code", "code_from": "2130" }] },
        { "code": "CL.4", "name": "مخصصات متداولة", "sequence": 180, "parent": "CL", "sign": -1,
          "rules": [{ "kind": "account_code", "code_from": "2150" }] },
        { "code": "NCL", "name": "الخصوم غير المتداولة", "sequence": 190, "is_total": true, "plus": ["NCL.1","NCL.2"] },
        { "code": "NCL.1", "name": "قروض طويلة الأجل", "sequence": 200, "parent": "NCL", "sign": -1,
          "rules": [{ "kind": "account_code", "code_from": "2300" }] },
        { "code": "NCL.2", "name": "مخصصات غير متداولة", "sequence": 210, "parent": "NCL", "sign": -1,
          "rules": [{ "kind": "account_code", "code_from": "2350" }] },
        { "code": "TL", "name": "إجمالي الخصوم", "sequence": 220, "is_total": true, "plus": ["CL","NCL"] },
        { "code": "NA", "name": "صافي الأصول", "sequence": 230, "is_total": true, "plus": ["TA"], "minus": ["TL"],
          "legal_reference": "يساوي حقوق الملكية بعد إقفال السنة، ويزيد عليها بنتيجة أعمال السنة المفتوحة قبل الإقفال." },
        { "code": "EQ", "name": "حقوق الملكية", "sequence": 240, "is_total": true, "plus": ["EQ.1","EQ.2","EQ.3"] },
        { "code": "EQ.1", "name": "رأس المال", "sequence": 250, "parent": "EQ", "sign": -1,
          "rules": [{ "kind": "account_code", "code_from": "3000" }] },
        { "code": "EQ.2", "name": "الاحتياطيات", "sequence": 260, "parent": "EQ", "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "3010", "code_to": "3030" }] },
        { "code": "EQ.3", "name": "الأرباح المرحلة", "sequence": 270, "parent": "EQ", "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "3200", "code_to": "3210" }] }
      ]
    },
    {
      "code": "EG-EAS-IS",
      "kind": "income_statement",
      "framework": "EG-EAS-SME",
      "taxonomy": null,
      "name": "قائمة الدخل — طبقًا لمعيار المنشآت الصغيرة والمتوسطة من معايير المحاسبة المصرية",
      "legal_reference": "Same source and same gap as EG-EAS-SFP above: built on the minimum line items of the IFRS for SMEs Accounting Standard, section 5, by nature of expense, which a small company's ledger holds without an allocation to functions.",
      "source": "eas-ifrs-profile",
      "lines": [
        { "code": "1", "name": "الإيرادات", "sequence": 10, "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "4000", "code_to": "4030" }] },
        { "code": "2", "name": "إيرادات أخرى", "sequence": 20, "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "4700", "code_to": "4790" }] },
        { "code": "3", "name": "تكلفة المبيعات", "sequence": 30, "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "5000", "code_to": "5030" }] },
        { "code": "4", "name": "تكلفة العاملين", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "6100", "code_to": "6130" }] },
        { "code": "5", "name": "الإهلاك والإطفاء", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "6500", "code_to": "6510" }] },
        { "code": "6", "name": "مصروفات تشغيل أخرى", "sequence": 60, "sign": 1,
          "rules": [
            { "kind": "code_range", "code_from": "6200", "code_to": "6440" },
            { "kind": "code_range", "code_from": "6900", "code_to": "6990" }
          ] },
        { "code": "7", "name": "أعباء تمويلية", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "7100" }] },
        { "code": "8", "name": "الربح قبل ضريبة الدخل", "sequence": 80, "is_total": true,
          "plus": ["1","2"], "minus": ["3","4","5","6","7"] },
        { "code": "9", "name": "مصروف ضريبة الدخل", "sequence": 90, "sign": 1,
          "rules": [{ "kind": "account_code", "code_from": "8000" }] },
        { "code": "10", "name": "صافي ربح السنة", "sequence": 100, "is_total": true,
          "plus": ["8"], "minus": ["9"] }
      ]
    }
  ]
}
