        { "code": "PAS", "parent": null, "name": "Total Pasivo", "sequence": 130, "is_total": true,
          "plus": ["21", "22"] },

        { "code": "31", "parent": "PAT", "name": "Capital", "sequence": 140, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "31" }] },
        { "code": "32", "parent": "PAT", "name": "Reservas", "sequence": 150, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "32" }] },
        { "code": "33", "parent": "PAT", "name": "Resultados", "sequence": 160, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "33" }] },
        { "code": "PAT", "parent": null, "name": "Total Patrimonio", "sequence": 170, "is_total": true,
          "plus": ["31", "32", "33"] }
      ]
    },
    {
