          "rules": [{ "kind": "code_prefix", "code_from": "51" }] },
        { "code": "52", "parent": "GO", "name": "Gastos por Trabajos, Suministros y Servicios", "sequence": 80, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "52" }] },
        { "code": "53", "parent": "GO", "name": "Arrendamientos", "sequence": 90, "sign": 1,
