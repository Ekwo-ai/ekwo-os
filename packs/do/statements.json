{
  "$schema": "https://ekwo.ai/schemas/pack/1.json",
  "statements": [
    {
      "code": "DO-IR2-A1",
      "kind": "balance_sheet",
      "framework": "DO-IR2",
      "name": "Balance General (Anexo A-1)",
      "legal_reference": "Instructivo de la Declaración Jurada del Impuesto sobre la Renta Persona Jurídica (IR-2) — el Anexo A-1, Balance General, es el estado de activos, pasivos y patrimonio que toda persona jurídica de los sectores manufactura, comercio, agropecuaria u hoteles declara junto con el IR-2; no es un estado bajo NIIF para PYMES en su forma completa, sino el resumen administrativo que la Dirección General de Impuestos Internos exige de todo contribuyente, en ausencia de un catálogo o de un formato de estados financieros único impuesto por la ley dominicana",
      "source": "ir2-instructivo",
      "lines": [
        { "code": "11", "parent": "AC", "name": "Disponible", "sequence": 10, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "11" }] },
        { "code": "12", "parent": "AC", "name": "Cuentas por Cobrar", "sequence": 20, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "12" }] },
        { "code": "13", "parent": "AC", "name": "Inventarios", "sequence": 30, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "13" }] },
        { "code": "14", "parent": "AC", "name": "Gastos Pagados por Anticipado", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "14" }] },
        { "code": "AC", "parent": "ACT", "name": "Total Activo Corriente", "sequence": 50, "is_total": true,
          "plus": ["11", "12", "13", "14"] },

        { "code": "15", "parent": "ANC", "name": "Activo Fijo", "sequence": 60, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "15" }] },
        { "code": "16", "parent": "ANC", "name": "Inversiones", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "16" }] },
        { "code": "17", "parent": "ANC", "name": "Otros Activos", "sequence": 80, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "17" }] },
        { "code": "ANC", "parent": "ACT", "name": "Total Activo No Corriente", "sequence": 90, "is_total": true,
          "plus": ["15", "16", "17"] },

        { "code": "ACT", "parent": null, "name": "Total Activo", "sequence": 100, "is_total": true,
          "plus": ["AC", "ANC"] },

        { "code": "21", "parent": "PAS", "name": "Pasivo Corriente", "sequence": 110, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "21" }] },
