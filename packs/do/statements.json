        { "code": "56", "parent": null, "name": "Gastos Financieros", "sequence": 130, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "56" }] },

        { "code": "57", "parent": null, "name": "Gastos Extraordinarios", "sequence": 140, "sign": 1,
