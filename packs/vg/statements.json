        "rules": [
          {
            "kind": "code_range",
            "code_from": "2060",
            "code_to": "2069"
          }
        ]
      }
    },
    {
      "statement": "VG-FR-BS",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
