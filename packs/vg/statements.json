        "name": "Finance costs and other expenses",
        "sequence": 65,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "6400",
            "code_to": "6469",
            "sequence": 10
          },
          {
            "kind": "code_range",
            "code_from": "6480",
            "code_to": "6799",
