      "source": "zgd-1",
      "lines": [
        { "code": "SRE", "name": "Sredstva", "sequence": 10, "is_total": true, "plus": ["A", "B", "C"], "legal_reference": "ZGD-1, 65. člen", "source": "zgd-1" },
        { "code": "A", "parent": "SRE", "name": "A. Dolgoročna sredstva", "sequence": 20, "is_total": true, "plus": ["A.I", "A.II", "A.III", "A.IV", "A.V", "A.VI"], "legal_reference": "ZGD-1, 65. člen, odstavek o sredstvih, točka A", "source": "zgd-1" },
