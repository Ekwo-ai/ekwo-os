{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "MT-GAPSME-BS",
      "kind": "balance_sheet",
      "framework": "MT-GAPSME",
      "name": "Balance Sheet — GAPSME horizontal layout",
      "legal_reference": "Accountancy Profession (General Accounting Principles for Small and Medium-Sized Entities) Regulations (S.L. 281.05), Section 4, paragraph 4.13 — the horizontal layout of the balance sheet, one of the two layouts an entity may adopt. Every heading and sub-item below is the format's own wording; items preceded by Arabic numerals may be combined when immaterial or for clarity, which paragraph 4.13 itself permits and which this chart does in a few places noted beside the line.",
      "source": "gapsme",
      "lines": [
        { "code": "NCA", "name": "Non-current assets", "sequence": 10, "is_total": true, "plus": ["NCA.I", "NCA.II", "NCA.III", "NCA.IV", "NCA.V", "NCA.VI"] },
        { "code": "NCA.I", "name": "Intangible assets", "sequence": 20, "parent": "NCA", "is_total": true, "plus": ["NCA.I.1", "NCA.I.2", "NCA.I.3", "NCA.I.4"] },
        { "code": "NCA.I.1", "name": "Development costs", "sequence": 30, "parent": "NCA.I", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0010", "code_to": "0011" }] },
        { "code": "NCA.I.2", "name": "Concessions, patents, licences, trade marks and similar rights and assets, if they were acquired for valuable consideration", "sequence": 40, "parent": "NCA.I", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0020", "code_to": "0021" }] },
        { "code": "NCA.I.3", "name": "Goodwill", "sequence": 50, "parent": "NCA.I", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0030", "code_to": "0031" }] },
        { "code": "NCA.I.4", "name": "Payments on account", "sequence": 60, "parent": "NCA.I", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0040" }] },
        { "code": "NCA.II", "name": "Property, plant and equipment", "sequence": 70, "parent": "NCA", "is_total": true, "plus": ["NCA.II.1", "NCA.II.2", "NCA.II.3", "NCA.II.4"] },
        { "code": "NCA.II.1", "name": "Land and buildings", "sequence": 80, "parent": "NCA.II", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0100", "code_to": "0101" }] },
        { "code": "NCA.II.2", "name": "Plant and machinery", "sequence": 90, "parent": "NCA.II", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0110", "code_to": "0111" }] },
        { "code": "NCA.II.3", "name": "Other fixtures, fittings, tools and equipment", "sequence": 100, "parent": "NCA.II", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "0120", "code_to": "0121" }] },
        { "code": "NCA.II.4", "name": "Payments on account and tangible assets in the course of construction", "sequence": 110, "parent": "NCA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0130" }] },
        { "code": "NCA.III", "name": "Investment property", "sequence": 120, "parent": "NCA", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0150" }] },
        { "code": "NCA.IV", "name": "Financial investments", "sequence": 130, "parent": "NCA", "is_total": true, "plus": ["NCA.IV.1", "NCA.IV.2", "NCA.IV.3", "NCA.IV.4", "NCA.IV.5", "NCA.IV.6"] },
        { "code": "NCA.IV.1", "name": "Shares in subsidiaries", "sequence": 140, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0200" }] },
        { "code": "NCA.IV.2", "name": "Loans to subsidiaries", "sequence": 150, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0210" }] },
        { "code": "NCA.IV.3", "name": "Shares in associates and jointly controlled entities", "sequence": 160, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0220" }] },
        { "code": "NCA.IV.4", "name": "Loans to associates and jointly controlled entities", "sequence": 170, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0230" }] },
        { "code": "NCA.IV.5", "name": "Other non-current investments other than loans", "sequence": 180, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0240" }] },
        { "code": "NCA.IV.6", "name": "Other loans", "sequence": 190, "parent": "NCA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0250" }] },
        { "code": "NCA.V", "name": "Trade and other receivables", "sequence": 200, "parent": "NCA", "is_total": true, "plus": ["NCA.V.1", "NCA.V.2", "NCA.V.3", "NCA.V.4", "NCA.V.5", "NCA.V.6"] },
        { "code": "NCA.V.1", "name": "Trade receivables", "sequence": 210, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0300" }] },
        { "code": "NCA.V.2", "name": "Amounts owed by group entities", "sequence": 220, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0310" }] },
        { "code": "NCA.V.3", "name": "Amounts owed by associates and jointly controlled entities", "sequence": 230, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0320" }] },
        { "code": "NCA.V.4", "name": "Other receivables", "sequence": 240, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0330" }] },
        { "code": "NCA.V.5", "name": "Subscribed capital called but not paid", "sequence": 250, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0340" }] },
        { "code": "NCA.V.6", "name": "Prepayments and accrued income", "sequence": 260, "parent": "NCA.V", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0350" }] },
        { "code": "NCA.VI", "name": "Deferred tax assets", "sequence": 270, "parent": "NCA", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "0400" }] },

        { "code": "CA", "name": "Current assets", "sequence": 280, "is_total": true, "plus": ["CA.I", "CA.II", "CA.III", "CA.IV", "CA.V"] },
        { "code": "CA.I", "name": "Inventories", "sequence": 290, "parent": "CA", "is_total": true, "plus": ["CA.I.1", "CA.I.2", "CA.I.3", "CA.I.4"] },
        { "code": "CA.I.1", "name": "Raw materials and consumables", "sequence": 300, "parent": "CA.I", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1000" }] },
        { "code": "CA.I.2", "name": "Work in progress", "sequence": 310, "parent": "CA.I", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1010" }] },
        { "code": "CA.I.3", "name": "Finished goods and goods for resale", "sequence": 320, "parent": "CA.I", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1020" }] },
        { "code": "CA.I.4", "name": "Payments on account", "sequence": 330, "parent": "CA.I", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1030" }] },
        { "code": "CA.II", "name": "Trade and other receivables", "sequence": 340, "parent": "CA", "is_total": true, "plus": ["CA.II.1", "CA.II.2", "CA.II.3", "CA.II.4", "CA.II.5", "CA.II.6"] },
        { "code": "CA.II.1", "name": "Trade receivables", "sequence": 350, "parent": "CA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1100" }] },
        { "code": "CA.II.2", "name": "Amounts owed by group entities", "sequence": 360, "parent": "CA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1110" }] },
        { "code": "CA.II.3", "name": "Amounts owed by associates and jointly controlled entities", "sequence": 370, "parent": "CA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1120" }] },
        { "code": "CA.II.4", "name": "Other receivables", "sequence": 380, "parent": "CA.II", "sign": 1, "rules": [
          { "kind": "code_range", "code_from": "1130", "code_to": "1150", "sequence": 10 },
          { "kind": "account_code", "code_from": "2450", "side": "debit", "sequence": 20 }
        ], "legal_reference": "Input VAT and VAT recoverable from the Commissioner for Revenue are other receivables; corporate tax recoverable reaches CA.III instead. The suspense account reaches this line while it is in debit and line CL.II.6 while it is in credit, the one way the format lets two lines share an account." },
        { "code": "CA.II.5", "name": "Subscribed capital called but not paid", "sequence": 390, "parent": "CA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1170" }] },
        { "code": "CA.II.6", "name": "Prepayments and accrued income", "sequence": 400, "parent": "CA.II", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1180" }] },
        { "code": "CA.III", "name": "Current tax assets", "sequence": 410, "parent": "CA", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1160" }] },
        { "code": "CA.IV", "name": "Financial investments", "sequence": 420, "parent": "CA", "is_total": true, "plus": ["CA.IV.1", "CA.IV.2", "CA.IV.3", "CA.IV.4", "CA.IV.5"] },
        { "code": "CA.IV.1", "name": "Shares in subsidiaries", "sequence": 430, "parent": "CA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1200" }] },
        { "code": "CA.IV.2", "name": "Loans to subsidiaries", "sequence": 440, "parent": "CA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1210" }] },
        { "code": "CA.IV.3", "name": "Shares in associates and jointly controlled entities", "sequence": 450, "parent": "CA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1220" }] },
        { "code": "CA.IV.4", "name": "Loans to associates and jointly controlled entities", "sequence": 460, "parent": "CA.IV", "sign": 1, "rules": [], "legal_reference": "No account of this chart posts here — this pack's golden scenario has no such loan — declared for fidelity to the format." },
        { "code": "CA.IV.5", "name": "Other current investments", "sequence": 470, "parent": "CA.IV", "sign": 1, "rules": [{ "kind": "account_code", "code_from": "1230" }] },
        { "code": "CA.V", "name": "Cash and cash equivalents", "sequence": 480, "parent": "CA", "sign": 1, "rules": [{ "kind": "code_range", "code_from": "1500", "code_to": "1550" }] },

        { "code": "TOTAL_ASSETS", "name": "Total assets", "sequence": 490, "is_total": true, "plus": ["NCA", "CA"] },

        { "code": "EQ", "name": "Equity", "sequence": 500, "is_total": true, "plus": ["EQ.I", "EQ.II", "EQ.III", "EQ.IV", "EQ.V", "EQ.VI"] },
        { "code": "EQ.I", "name": "Share capital", "sequence": 510, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3000" }] },
        { "code": "EQ.II", "name": "Share premium account", "sequence": 520, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3010" }] },
        { "code": "EQ.III", "name": "Revaluation reserve", "sequence": 530, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3020" }] },
        { "code": "EQ.IV", "name": "Other reserves", "sequence": 540, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3030" }] },
        { "code": "EQ.V", "name": "Retained earnings", "sequence": 550, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3400" }] },
        { "code": "EQ.VI", "name": "Minority interest", "sequence": 560, "parent": "EQ", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "3460" }] },

        { "code": "NCL", "name": "Non-current liabilities", "sequence": 570, "is_total": true, "plus": ["NCL.I", "NCL.II", "NCL.III", "NCL.IV"] },
        { "code": "NCL.I", "name": "Borrowings", "sequence": 580, "parent": "NCL", "is_total": true, "plus": ["NCL.I.1", "NCL.I.2"] },
        { "code": "NCL.I.1", "name": "Bank loans", "sequence": 590, "parent": "NCL.I", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4000" }] },
        { "code": "NCL.I.2", "name": "Other borrowings", "sequence": 600, "parent": "NCL.I", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4010" }] },
        { "code": "NCL.II", "name": "Trade and other payables", "sequence": 610, "parent": "NCL", "is_total": true, "plus": ["NCL.II.1", "NCL.II.2", "NCL.II.3", "NCL.II.4", "NCL.II.5", "NCL.II.6", "NCL.II.7"] },
        { "code": "NCL.II.1", "name": "Payments received on account of orders", "sequence": 620, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4100" }] },
        { "code": "NCL.II.2", "name": "Trade payables", "sequence": 630, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4110" }] },
        { "code": "NCL.II.3", "name": "Bills of exchange payable", "sequence": 640, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4120" }] },
        { "code": "NCL.II.4", "name": "Amounts owed to group entities", "sequence": 650, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4130" }] },
        { "code": "NCL.II.5", "name": "Amounts owed to associates and jointly controlled entities", "sequence": 660, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4140" }] },
        { "code": "NCL.II.6", "name": "Other creditors (including indirect tax and social security)", "sequence": 670, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4150" }] },
        { "code": "NCL.II.7", "name": "Accruals and deferred income", "sequence": 680, "parent": "NCL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4160" }] },
        { "code": "NCL.III", "name": "Deferred tax liabilities", "sequence": 690, "parent": "NCL", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4200" }] },
        { "code": "NCL.IV", "name": "Provisions", "sequence": 700, "parent": "NCL", "is_total": true, "plus": ["NCL.IV.1", "NCL.IV.2"] },
        { "code": "NCL.IV.1", "name": "Provisions for employee benefits and similar obligations", "sequence": 710, "parent": "NCL.IV", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4300" }] },
        { "code": "NCL.IV.2", "name": "Other provisions", "sequence": 720, "parent": "NCL.IV", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "4310" }] },

        { "code": "CL", "name": "Current liabilities", "sequence": 730, "is_total": true, "plus": ["CL.I", "CL.II", "CL.III", "CL.IV"] },
        { "code": "CL.I", "name": "Borrowings", "sequence": 740, "parent": "CL", "is_total": true, "plus": ["CL.I.1", "CL.I.2"] },
        { "code": "CL.I.1", "name": "Bank loans", "sequence": 750, "parent": "CL.I", "sign": -1, "rules": [{ "kind": "code_range", "code_from": "2000", "code_to": "2010" }] },
        { "code": "CL.I.2", "name": "Other borrowings", "sequence": 760, "parent": "CL.I", "sign": -1, "rules": [{ "kind": "code_range", "code_from": "2020", "code_to": "2030" }] },
        { "code": "CL.II", "name": "Trade and other payables", "sequence": 770, "parent": "CL", "is_total": true, "plus": ["CL.II.1", "CL.II.2", "CL.II.3", "CL.II.4", "CL.II.5", "CL.II.6", "CL.II.7"] },
        { "code": "CL.II.1", "name": "Payments received on account of orders", "sequence": 780, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2105" }] },
        { "code": "CL.II.2", "name": "Trade payables", "sequence": 790, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2100" }] },
        { "code": "CL.II.3", "name": "Bills of exchange payable", "sequence": 800, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2110" }] },
        { "code": "CL.II.4", "name": "Amounts owed to group entities", "sequence": 810, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2120" }] },
        { "code": "CL.II.5", "name": "Amounts owed to associates and jointly controlled entities", "sequence": 820, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2130" }] },
        { "code": "CL.II.6", "name": "Other creditors (including indirect tax and social security)", "sequence": 830, "parent": "CL.II", "sign": -1, "rules": [
          { "kind": "code_range", "code_from": "2200", "code_to": "2220", "sequence": 10 },
          { "kind": "account_code", "code_from": "2300", "sequence": 20 },
          { "kind": "account_code", "code_from": "2450", "side": "credit", "sequence": 30 }
        ], "legal_reference": "Output VAT, VAT payable to the Commissioner for Revenue, social security payable and other creditors are other creditors; corporate tax payable reaches CL.III instead. The suspense account reaches this line while it is in credit." },
        { "code": "CL.II.7", "name": "Accruals and deferred income", "sequence": 840, "parent": "CL.II", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2400" }] },
        { "code": "CL.III", "name": "Current tax liabilities", "sequence": 850, "parent": "CL", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2230" }] },
        { "code": "CL.IV", "name": "Provisions", "sequence": 860, "parent": "CL", "is_total": true, "plus": ["CL.IV.1", "CL.IV.2"] },
        { "code": "CL.IV.1", "name": "Provisions for employee benefits and similar obligations", "sequence": 870, "parent": "CL.IV", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2500" }] },
        { "code": "CL.IV.2", "name": "Other provisions", "sequence": 880, "parent": "CL.IV", "sign": -1, "rules": [{ "kind": "account_code", "code_from": "2510" }] },

        { "code": "TOTAL_EQUITY_AND_LIABILITIES", "name": "Total equity and liabilities", "sequence": 890, "is_total": true, "plus": ["EQ", "NCL", "CL"] }
      ]
    },
    {
      "code": "MT-GAPSME-IS",
      "kind": "income_statement",
      "framework": "MT-GAPSME",
      "name": "Income Statement — GAPSME, function of expense method",
      "legal_reference": "Accountancy Profession (General Accounting Principles for Small and Medium-Sized Entities) Regulations (S.L. 281.05), Section 4, paragraphs 4.21 and 4.22 — an entity classifies its expenses by nature or by function, whichever is reliable and more relevant; this pack transcribes the function-of-expense method. Items 7 and 8 of paragraph 4.22 — income under the cost method and the equity method from shares in subsidiaries, associates and jointly controlled entities — are combined on one line of this chart, which paragraph 4.21 itself permits where items may be combined for clarity.",
      "source": "gapsme",
      "lines": [
        { "code": "1", "name": "Revenue", "sequence": 10, "sign": -1, "rules": [{ "kind": "code_range", "code_from": "5000", "code_to": "5110" }], "legal_reference": "Sales returns and discounts allowed reduce revenue." },
        { "code": "2", "name": "Cost of sales", "sequence": 20, "sign": 1, "rules": [{ "kind": "code_range", "code_from": "6000", "code_to": "6110" }] },
        { "code": "3", "name": "Gross profit or loss", "sequence": 30, "is_total": true, "plus": ["1"], "minus": ["2"] },
        { "code": "4", "name": "Distribution costs", "sequence": 40, "sign": 1, "rules": [{ "kind": "code_range", "code_from": "7000", "code_to": "7050" }] },
        { "code": "5", "name": "Administrative expenses", "sequence": 50, "sign": 1, "rules": [{ "kind": "code_range", "code_from": "7100", "code_to": "7690" }], "legal_reference": "Depreciation, the loss on disposal of fixed assets, foreign exchange losses and rounding differences are administrative expenses." },
        { "code": "6", "name": "Other operating income", "sequence": 60, "sign": -1, "rules": [{ "kind": "code_range", "code_from": "5200", "code_to": "5230" }] },
        { "code": "7", "name": "Income from shares in subsidiaries, associates and jointly controlled entities", "sequence": 70, "sign": -1, "rules": [{ "kind": "account_code", "code_from": "5240" }], "legal_reference": "Paragraph 4.22 items 7 and 8 — income accounted for under the cost method and the equity method, combined on this one line as paragraph 4.21 permits." },
        { "code": "9", "name": "Income from other investments", "sequence": 80, "sign": -1, "rules": [{ "kind": "account_code", "code_from": "5250" }] },
        { "code": "10", "name": "Other interest receivable and similar income", "sequence": 90, "sign": -1, "rules": [{ "kind": "account_code", "code_from": "5260" }] },
        { "code": "11", "name": "Adjustments to the carrying amounts of other investments held as current assets", "sequence": 100, "sign": 1, "rules": [{ "kind": "account_code", "code_from": "8000" }] },
        { "code": "12", "name": "Interest payable and similar charges", "sequence": 110, "sign": 1, "rules": [{ "kind": "code_range", "code_from": "8010", "code_to": "8030" }], "legal_reference": "Late payment interest and the compensation for recovery costs paid to a supplier are interest payable and similar charges." },
        { "code": "13", "name": "Profit or loss before tax for the period", "sequence": 120, "is_total": true, "plus": ["3", "6", "7", "9", "10"], "minus": ["4", "5", "11", "12"] },
        { "code": "14", "name": "Tax on profit or loss before tax", "sequence": 130, "sign": 1, "rules": [{ "kind": "account_code", "code_from": "8100" }] },
        { "code": "15", "name": "Profit or loss after tax for the period", "sequence": 140, "is_total": true, "plus": ["13"], "minus": ["14"] }
      ]
    }
  ]
}
