{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "KZ-IFRS-BS",
      "kind": "balance_sheet",
      "framework": "ХҚЕС",
      "name": "Қаржылық жағдайы туралы есеп",
      "valid_from": "2013-01-01",
      "legal_reference": "«Бухгалтерлік есеп пен қаржылық есептілік туралы» Заң, 2-бап пен 6-бап — коммерциялық ұйымдар ХҚЕС-ке немесе ШОБ субъектілері үшін ХҚЕС-ке сәйкес қаржылық есептілік жасайды; ХҚЕС (IAS) 1-стандарты қаржылық жағдайы туралы есептің құрылымын белгілейді. Бұл дестеде Қаржы министрінің № 185 бұйрығымен бекітілген Бухгалтерлік есептің үлгі шоттар жоспарының бес бөлімін (қысқа мерзімді активтер, ұзақ мерзімді активтер, қысқа мерзімді міндеттемелер, ұзақ мерзімді міндеттемелер, капитал мен резервтер) тікелей көрсететін жолдар транскрипцияланған — бұл ешбір ХҚЕС ресми кестесі емес, дестенің өз құрастыруы; қараңыз README.md.",
      "source": "coa-order-185",
      "lines": [
        { "code": "AS-CASH", "name": "Ақша қаражаты", "sequence": 10, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1000", "code_to": "1099" } ] },
        { "code": "AS-STFA", "name": "Қысқа мерзімді қаржы активтері", "sequence": 20, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1100", "code_to": "1199" } ] },
        { "code": "AS-STREC", "name": "Қысқа мерзімді дебиторлық берешек", "sequence": 30, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1200", "code_to": "1299" } ] },
        { "code": "AS-INV", "name": "Қорлар", "sequence": 40, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1300", "code_to": "1399" } ] },
        { "code": "AS-CTAX", "name": "Ағымдағы салықтық активтер", "sequence": 50, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1400", "code_to": "1499" } ] },
        { "code": "AS-OCA", "name": "Басқа қысқа мерзімді активтер", "sequence": 60, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1700", "code_to": "1799" } ] },
        { "code": "AS-CA-TOTAL", "name": "Қысқа мерзімді активтер жиынтығы", "sequence": 70, "is_total": true,
          "plus": ["AS-CASH", "AS-STFA", "AS-STREC", "AS-INV", "AS-CTAX", "AS-OCA"] },
        { "code": "AS-LTFA", "name": "Ұзақ мерзімді қаржы активтері", "sequence": 80, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2000", "code_to": "2099" } ] },
        { "code": "AS-LTREC", "name": "Ұзақ мерзімді дебиторлық берешек", "sequence": 90, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2100", "code_to": "2199" } ] },
        { "code": "AS-INVEST", "name": "Инвестициялар", "sequence": 100, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2200", "code_to": "2299" } ] },
        { "code": "AS-INVPROP", "name": "Инвестициялық мүлік", "sequence": 110, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2300", "code_to": "2399" } ] },
        { "code": "AS-PPE", "name": "Негізгі құралдар", "sequence": 120, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2400", "code_to": "2499" } ] },
        { "code": "AS-EXPLOR", "name": "Барлау және бағалау активтері", "sequence": 130, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2600", "code_to": "2699" } ] },
        { "code": "AS-INTANG", "name": "Материалдық емес активтер", "sequence": 140, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2700", "code_to": "2799" } ] },
        { "code": "AS-DTA", "name": "Кейінге қалдырылған салық активтері", "sequence": 150, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2800", "code_to": "2899" } ] },
        { "code": "AS-ONCA", "name": "Басқа ұзақ мерзімді активтер", "sequence": 160, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2900", "code_to": "2999" } ] },
        { "code": "AS-NCA-TOTAL", "name": "Ұзақ мерзімді активтер жиынтығы", "sequence": 170, "is_total": true,
          "plus": ["AS-LTFA", "AS-LTREC", "AS-INVEST", "AS-INVPROP", "AS-PPE", "AS-EXPLOR", "AS-INTANG", "AS-DTA", "AS-ONCA"] },
        { "code": "AS-TOTAL", "name": "Активтер жиынтығы (баланс)", "sequence": 180, "is_total": true,
          "plus": ["AS-CA-TOTAL", "AS-NCA-TOTAL"] },
        { "code": "EQ-SHARE", "name": "Жарғылық капитал", "sequence": 190, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5000", "code_to": "5099" } ] },
        { "code": "EQ-UNPAID", "name": "Төленбеген капитал", "sequence": 200, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5100", "code_to": "5199" } ] },
        { "code": "EQ-PREMIUM", "name": "Эмиссиялық кіріс", "sequence": 210, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5300", "code_to": "5399" } ] },
        { "code": "EQ-RESERVES", "name": "Резервтер", "sequence": 220, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5500", "code_to": "5599" } ] },
        { "code": "EQ-RETAINED", "name": "Бөлінбеген пайда (жабылмаған зиян)", "sequence": 230, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5600", "code_to": "5699" } ] },
        { "code": "EQ-TOTAL", "name": "Капитал жиынтығы", "sequence": 240, "is_total": true,
          "plus": ["EQ-SHARE", "EQ-PREMIUM", "EQ-RESERVES", "EQ-RETAINED"], "minus": ["EQ-UNPAID"] },
        { "code": "LI-STFIN", "name": "Қысқа мерзімді қаржылық міндеттемелер", "sequence": 250, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3000", "code_to": "3099" } ] },
        { "code": "LI-TAX", "name": "Салықтар бойынша міндеттемелер", "sequence": 260, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3100", "code_to": "3199" } ] },
        { "code": "LI-OTHERMAND", "name": "Басқа міндетті және ерікті төлемдер бойынша міндеттемелер", "sequence": 270, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3200", "code_to": "3299" } ] },
        { "code": "LI-STPAY", "name": "Қысқа мерзімді кредиторлық берешек", "sequence": 280, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3300", "code_to": "3399" } ] },
        { "code": "LI-STPROV", "name": "Қысқа мерзімді бағалау міндеттемелері", "sequence": 290, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3400", "code_to": "3499" } ] },
        { "code": "LI-OTHERST", "name": "Басқа қысқа мерзімді міндеттемелер", "sequence": 300, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3500", "code_to": "3599" } ] },
        { "code": "LI-CL-TOTAL", "name": "Қысқа мерзімді міндеттемелер жиынтығы", "sequence": 310, "is_total": true,
          "plus": ["LI-STFIN", "LI-TAX", "LI-OTHERMAND", "LI-STPAY", "LI-STPROV", "LI-OTHERST"] },
        { "code": "LI-LTFIN", "name": "Ұзақ мерзімді қаржылық міндеттемелер", "sequence": 320, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4000", "code_to": "4099" } ] },
        { "code": "LI-LTPAY", "name": "Ұзақ мерзімді кредиторлық берешек", "sequence": 330, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4100", "code_to": "4199" } ] },
        { "code": "LI-LTPROV", "name": "Ұзақ мерзімді бағалау міндеттемелері", "sequence": 340, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4200", "code_to": "4299" } ] },
        { "code": "LI-DTL", "name": "Кейінге қалдырылған салық міндеттемелері", "sequence": 350, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4300", "code_to": "4399" } ] },
        { "code": "LI-OTHERLT", "name": "Басқа ұзақ мерзімді міндеттемелер", "sequence": 360, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4400", "code_to": "4499" } ] },
        { "code": "LI-NCL-TOTAL", "name": "Ұзақ мерзімді міндеттемелер жиынтығы", "sequence": 370, "is_total": true,
          "plus": ["LI-LTFIN", "LI-LTPAY", "LI-LTPROV", "LI-DTL", "LI-OTHERLT"] },
        { "code": "EQLI-TOTAL", "name": "Капитал мен міндеттемелер жиынтығы (баланс)", "sequence": 380, "is_total": true,
          "plus": ["EQ-TOTAL", "LI-CL-TOTAL", "LI-NCL-TOTAL"] }
      ]
    },
    {
      "code": "KZ-IFRS-IS",
      "kind": "income_statement",
      "framework": "ХҚЕС",
      "name": "Пайда мен зиян және өзге де жиынтық кіріс туралы есеп",
      "valid_from": "2013-01-01",
      "legal_reference": "«Бухгалтерлік есеп пен қаржылық есептілік туралы» Заң, 2-бап пен 6-бап; ХҚЕС (IAS) 1-стандарты. Бұл дестеде Бухгалтерлік есептің үлгі шоттар жоспарының 6-бөлімі (кірістер) мен 7-бөлімі (шығыстар) тікелей көрсететін жолдар транскрипцияланған, өзге де жиынтық кіріс бөлімінсіз — ешбір осы дестенің шоты оны қажет етпейді; қараңыз README.md.",
      "source": "coa-order-185",
      "lines": [
        { "code": "IS-REV", "name": "Өнімді сату және қызмет көрсетуден түскен кіріс", "sequence": 10, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "6000", "code_to": "6099" } ] },
        { "code": "IS-COGS", "name": "Сатылған өнім мен көрсетілген қызметтердің өзіндік құны", "sequence": 20, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7000", "code_to": "7099" } ] },
        { "code": "IS-GROSS", "name": "Жалпы пайда (зиян)", "sequence": 30, "is_total": true,
          "plus": ["IS-REV"], "minus": ["IS-COGS"] },
        { "code": "IS-SELL", "name": "Өнімді сатумен байланысты шығыстар", "sequence": 40, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7100", "code_to": "7199" } ] },
        { "code": "IS-ADMIN", "name": "Әкімшілік шығыстар", "sequence": 50, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7200", "code_to": "7299" } ] },
        { "code": "IS-OPINC", "name": "Басқа кірістер", "sequence": 60, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "6200", "code_to": "6299" } ] },
        { "code": "IS-OPEXP", "name": "Басқа шығыстар", "sequence": 70, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7400", "code_to": "7499" } ] },
        { "code": "IS-OPRESULT", "name": "Операциялық қызметтен түскен қаржылық нәтиже (пайда/зиян)", "sequence": 80, "is_total": true,
          "plus": ["IS-GROSS", "IS-OPINC"], "minus": ["IS-SELL", "IS-ADMIN", "IS-OPEXP"] },
        { "code": "IS-FININC", "name": "Қаржыландырудан түскен кірістер", "sequence": 90, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "6100", "code_to": "6199" } ] },
        { "code": "IS-FINEXP", "name": "Қаржыландыруға арналған шығыстар", "sequence": 100, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7300", "code_to": "7399" } ] },
        { "code": "IS-PRETAX", "name": "Салық салынғанға дейінгі қаржылық нәтиже (пайда/зиян)", "sequence": 110, "is_total": true,
          "plus": ["IS-OPRESULT", "IS-FININC"], "minus": ["IS-FINEXP"] },
        { "code": "IS-CIT", "name": "Корпоративтік табыс салығы бойынша шығыстар", "sequence": 120, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "7700", "code_to": "7799" } ] },
        { "code": "IS-NET", "name": "Таза қаржылық нәтиже (пайда/зиян)", "sequence": 130, "is_total": true,
          "plus": ["IS-PRETAX"], "minus": ["IS-CIT"] }
      ]
    }
  ]
}
