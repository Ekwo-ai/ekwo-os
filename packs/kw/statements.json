{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "inherit": "IFRS-SME",
  "statements": [
    {
      "code": "KW-IFRS-SFP",
      "kind": "balance_sheet",
      "framework": "IFRS",
      "name": "Statement of financial position — full IFRS Accounting Standards",
      "legal_reference": "Full IFRS Accounting Standards are required of every company under the Commercial Companies Law, by Ministerial Decree No. 18 of 1990 as amended by No. 101 of 2008; the IFRS for SMEs Standard is not adopted (IFRS Foundation, Jurisdictional Profile: Kuwait). Lines follow IAS 1 (statement of financial position; profit or loss). The statement of other comprehensive income is not modelled: this chart carries no OCI account. The line numbering and the account ranges are this pack's own.",
      "result_in_progress": "alone",
      "source": "ifrs-kuwait-profile"
    },
    {
      "code": "KW-IFRS-IS",
      "kind": "income_statement",
      "framework": "IFRS",
      "name": "Income statement — full IFRS Accounting Standards",
      "legal_reference": "Full IFRS Accounting Standards are required of every company under the Commercial Companies Law, by Ministerial Decree No. 18 of 1990 as amended by No. 101 of 2008; the IFRS for SMEs Standard is not adopted (IFRS Foundation, Jurisdictional Profile: Kuwait). Lines follow IAS 1 (statement of financial position; profit or loss). The statement of other comprehensive income is not modelled: this chart carries no OCI account. The line numbering and the account ranges are this pack's own.",
      "source": "ifrs-kuwait-profile"
    }
  ],
  "overrides": [
    {
      "statement": "KW-IFRS-SFP",
      "line": "A-NC-FIX",
      "name": "Property, plant and equipment"
    },
    {
      "statement": "KW-IFRS-SFP",
      "add": {
        "code": "A-NC-INT",
        "parent": "A-NC",
        "name": "Goodwill and other intangible assets",
        "sequence": 15,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1800",
            "code_to": "1899"
          }
        ]
      }
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "A-NC",
      "plus": [
        "A-NC-FIX",
        "A-NC-INT",
        "A-NC-OTH"
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "A-C-REC",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1100",
          "code_to": "1199"
        }
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "add": {
        "code": "A-C-INV",
        "parent": "A-C",
        "name": "Inventories",
        "sequence": 45,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1200",
            "code_to": "1299"
          }
        ]
      }
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "A-C-OTH",
      "name": "Other current assets",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1300",
          "code_to": "1399"
        }
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "add": {
        "code": "A-C-PRE",
        "parent": "A-C",
        "name": "Prepayments and deposits paid",
        "sequence": 55,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1400",
            "code_to": "1499"
          }
        ]
      }
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "A-C",
      "plus": [
        "A-C-REC",
        "A-C-INV",
        "A-C-OTH",
        "A-C-PRE",
        "A-C-CASH"
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "E-CAP",
      "name": "Share capital and reserves"
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "E-RET",
      "name": "Retained profits"
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "E-RESULT",
      "name": "Profit or loss for the year, not yet allocated"
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "L-C-PAY",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2000",
          "code_to": "2059"
        }
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "add": {
        "code": "L-C-TAX",
        "parent": "L-C",
        "name": "Current tax liabilities",
        "sequence": 135,
        "sign": -1,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "2060",
            "code_to": "2069"
          }
        ]
      }
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
          "sequence": 20
        }
      ]
    },
    {
      "statement": "KW-IFRS-SFP",
      "line": "L-C",
      "plus": [
        "L-C-PAY",
        "L-C-TAX",
        "L-C-OTH"
      ]
    },
    {
      "statement": "KW-IFRS-IS",
      "line": "OPEX",
      "name": "Administrative and other operating expenses"
    },
    {
      "statement": "KW-IFRS-IS",
      "line": "PROFIT",
      "name": "Profit (loss) for the year"
    }
  ]
}
