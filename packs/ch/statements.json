{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "CH-OR-959-BS",
      "kind": "balance_sheet",
      "framework": "CH-OR",
      "name": "Bilanz nach Art. 959 OR",
      "legal_reference": "Obligationenrecht (OR), Art. 959 Abs. 1 — die Bilanz stellt die Vermögens- und Finanzierungslage des Unternehmens am Bilanzstichtag dar. Abs. 5 gibt die Mindestgliederung des Umlauf- und des Anlagevermögens, Abs. 6 die des kurz- und des langfristigen Fremdkapitals sowie des Eigenkapitals. Jede Position unten ist eine Ziffer dieser beiden Absätze; wo mehrere Ziffern zu einer Zeile zusammengefasst sind, weil dieser Kontenrahmen keine eigene Kontenreihe für sie führt, sagt die Zeile es selbst.",
      "source": "or",
      "lines": [
        {
          "code": "AKT",
          "name": "Total Aktiven",
          "sequence": 10,
          "is_total": true,
          "plus": ["UV", "AV"]
        },
        {
          "code": "UV",
          "parent": "AKT",
          "name": "Umlaufvermögen",
          "sequence": 20,
          "is_total": true,
          "plus": ["UV.1", "UV.2", "UV.3", "UV.4", "UV.5"],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1",
          "source": "or"
        },
        {
          "code": "UV.1",
          "parent": "UV",
          "name": "Flüssige Mittel und kurzfristig gehaltene Aktiven mit Börsenkurs",
          "sequence": 30,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1000", "code_to": "1099" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1 Bst. a",
          "source": "or"
        },
        {
          "code": "UV.2",
          "parent": "UV",
          "name": "Forderungen aus Lieferungen und Leistungen",
          "sequence": 40,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1100", "code_to": "1119" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1 Bst. b",
          "source": "or"
        },
        {
          "code": "UV.3",
          "parent": "UV",
          "name": "Sonstige kurzfristige Forderungen",
          "sequence": 50,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1140", "code_to": "1189" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1 Bst. c",
          "source": "or"
        },
        {
          "code": "UV.4",
          "parent": "UV",
          "name": "Vorräte und nicht fakturierte Dienstleistungen",
          "sequence": 60,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1200", "code_to": "1299" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1 Bst. d",
          "source": "or"
        },
        {
          "code": "UV.5",
          "parent": "UV",
          "name": "Aktive Rechnungsabgrenzungen",
          "sequence": 70,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1300", "code_to": "1399" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 1 Bst. e",
          "source": "or"
        },
        {
          "code": "AV",
          "parent": "AKT",
          "name": "Anlagevermögen",
          "sequence": 80,
          "is_total": true,
          "plus": ["AV.1", "AV.2"],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 2",
          "source": "or"
        },
        {
          "code": "AV.1",
          "parent": "AV",
          "name": "Sachanlagen",
          "sequence": 90,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1500", "code_to": "1699" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 2 Bst. c",
          "source": "or"
        },
        {
          "code": "AV.2",
          "parent": "AV",
          "name": "Finanzanlagen und Beteiligungen",
          "sequence": 100,
          "sign": 1,
          "rules": [{ "kind": "code_range", "code_from": "1700", "code_to": "1799" }],
          "legal_reference": "OR Art. 959 Abs. 5 Ziff. 2 Bst. a und b",
          "source": "or"
        },
        {
          "code": "PAS",
          "name": "Total Passiven",
          "sequence": 110,
          "is_total": true,
          "plus": ["FK1", "FK2", "EK"]
        },
        {
          "code": "FK1",
          "parent": "PAS",
          "name": "Kurzfristiges Fremdkapital",
          "sequence": 120,
          "is_total": true,
          "plus": ["FK1.1", "FK1.2"],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 1",
          "source": "or"
        },
        {
          "code": "FK1.1",
          "parent": "FK1",
          "name": "Verbindlichkeiten aus Lieferungen und Leistungen",
          "sequence": 130,
          "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "2000", "code_to": "2029" }],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 1 Bst. a",
          "source": "or"
        },
        {
          "code": "FK1.2",
          "parent": "FK1",
          "name": "Übrige kurzfristige Verbindlichkeiten, Rückstellungen und passive Rechnungsabgrenzungen",
          "sequence": 140,
          "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "2030", "code_to": "2399" }],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 1 Bst. b bis d — dieser Kontenrahmen führt für diese drei Ziffern eine gemeinsame Kontenreihe, so dass sie hier eine Zeile bilden.",
          "source": "or"
        },
        {
          "code": "FK2",
