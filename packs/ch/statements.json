          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 2",
          "source": "or"
        },
        {
          "code": "EK",
          "parent": "PAS",
          "name": "Eigenkapital",
          "sequence": 160,
          "is_total": true,
          "plus": ["EK.1", "EK.2"],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 3",
          "source": "or"
        },
        {
          "code": "EK.1",
          "parent": "EK",
          "name": "Kapital und Reserven",
          "sequence": 170,
          "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "2800", "code_to": "2899" }],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 3 Bst. a bis d",
          "source": "or"
        },
        {
          "code": "EK.2",
          "parent": "EK",
          "name": "Bilanzgewinn oder Bilanzverlust",
          "sequence": 180,
          "sign": -1,
          "rules": [{ "kind": "code_range", "code_from": "2900", "code_to": "2999" }],
          "legal_reference": "OR Art. 959 Abs. 6 Ziff. 3 Bst. d",
          "source": "or"
        }
