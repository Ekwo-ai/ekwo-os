{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "statements": [
    {
      "code": "DK-ARL-BS",
      "kind": "balance_sheet",
      "framework": "DK-ARL",
      "name": "Balance i kontoform — bilag 2, skema 1",
      "valid_from": "2016-01-01",
      "legal_reference": "Årsregnskabsloven, § 23, stk. 1, jf. bilag 2, skema 1 — balancen i kontoform, for virksomheder i regnskabsklasse B, C og D. Kontoplanets ni klasser er selv bygget om denne opstillings hovedposter, hvilket er hvorfor koderne herunder ser vilkårlige ud",
      "source": "arsregnskabsloven",
      "lines": [
        { "code": "AKTIVER", "name": "AKTIVER I ALT", "sequence": 5, "is_total": true, "plus": ["A", "B"] },
        { "code": "A", "name": "Anlægsaktiver", "sequence": 10, "is_total": true, "plus": ["A.I", "A.II", "A.III"] },
        { "code": "A.I", "parent": "A", "name": "Immaterielle anlægsaktiver", "sequence": 20, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1000", "code_to": "1099" } ] },
        { "code": "A.II", "parent": "A", "name": "Materielle anlægsaktiver", "sequence": 30, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1100", "code_to": "1199" } ] },
        { "code": "A.III", "parent": "A", "name": "Finansielle anlægsaktiver", "sequence": 40, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "1200", "code_to": "1299" } ] },
        { "code": "B", "name": "Omsætningsaktiver", "sequence": 50, "is_total": true, "plus": ["B.I", "B.II", "B.III", "B.IV"] },
        { "code": "B.I", "parent": "B", "name": "Varebeholdninger", "sequence": 60, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2000", "code_to": "2099" } ] },
        { "code": "B.II", "parent": "B", "name": "Tilgodehavender", "sequence": 70, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2100", "code_to": "2199" } ] },
        { "code": "B.III", "parent": "B", "name": "Værdipapirer og kapitalandele", "sequence": 80, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2200", "code_to": "2299" } ] },
        { "code": "B.IV", "parent": "B", "name": "Likvide beholdninger", "sequence": 90, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "2300", "code_to": "2399" } ] },
        { "code": "PASSIVER", "name": "PASSIVER I ALT", "sequence": 95, "is_total": true, "plus": ["C", "D", "E", "F"] },
        { "code": "C", "name": "Egenkapital", "sequence": 100, "is_total": true, "plus": ["C.I", "C.II", "C.III", "C.IV", "C.V"] },
        { "code": "C.I", "parent": "C", "name": "Virksomhedskapital", "sequence": 110, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "3000" } ] },
        { "code": "C.II", "parent": "C", "name": "Overkurs ved emission", "sequence": 120, "sign": -1,
