        { "code": "16", "name": "Skat af årets resultat", "sequence": 130, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "8200", "code_to": "8299" } ] },
        { "code": "17", "name": "Andre skatter", "sequence": 140, "sign": 1,
          "rules": [ { "kind": "code_range", "code_from": "8300", "code_to": "8399" } ] },
        { "code": "18", "name": "Årets resultat", "sequence": 150, "is_total": true,
          "plus": ["1", "4", "13"], "minus": ["5a", "5b", "6", "7", "9", "15b", "16", "17"] }
