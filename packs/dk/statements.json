          "rules": [ { "kind": "account_code", "code_from": "3020" } ] },
        { "code": "C.IV", "parent": "C", "name": "Andre reserver", "sequence": 140, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "3030", "code_to": "3049" } ] },
        { "code": "C.V", "parent": "C", "name": "Overført overskud eller underskud", "sequence": 150, "sign": -1,
          "rules": [ { "kind": "account_code", "code_from": "3090" } ] },
        { "code": "D", "name": "Hensatte forpligtelser", "sequence": 160, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4000", "code_to": "4099" } ] },
        { "code": "E", "name": "Langfristede gældsforpligtelser", "sequence": 170, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "4100", "code_to": "4199" } ] },
        { "code": "F", "name": "Kortfristede gældsforpligtelser", "sequence": 180, "sign": -1,
          "rules": [ { "kind": "code_range", "code_from": "5000", "code_to": "5299" } ] }
      ]
    },
    {
