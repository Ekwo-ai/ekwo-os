{
  "$schema": "https://ekwo.ai/schemas/pack/1.json",
  "statements": [
    {
      "code": "CR-CCOM-ESF",
      "kind": "balance_sheet",
      "framework": "CR-CCOM",
      "name": "Balance General de Situación",
      "legal_reference": "Código de Comercio, art. 258 — cada cierre de ejercicio fiscal se asienta en el libro de Balances, entre otros, el Balance General de Situación posterior al cierre, distinguiendo el activo del pasivo y del patrimonio. Este esquema es una estructura mínima sobre esos rubros; la presentación completa de acuerdo con las NIIF o las NIIF para las PYMES es la que adopta el Colegio de Contadores Públicos de Costa Rica, cuyo texto pertenece al IASB y al Colegio y no se transcribe aquí — ver README.md",
      "source": "ccom",
      "lines": [
        { "code": "CB", "parent": null, "name": "Efectivo y equivalentes de efectivo", "sequence": 10, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "111" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "INV", "parent": null, "name": "Inversiones corrientes", "sequence": 20, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "112" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CXC", "parent": null, "name": "Cuentas por cobrar comerciales", "sequence": 30, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "113" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "OCR", "parent": null, "name": "Otras cuentas por cobrar", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "114" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CFI", "parent": null, "name": "Créditos fiscales de IVA", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "115" }],
          "legal_reference": "Ley del IVA, art. 25 — el crédito fiscal computable y el saldo a favor del contribuyente", "source": "liva" },
        { "code": "INVT", "parent": null, "name": "Inventarios", "sequence": 60, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "116" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PPI", "parent": null, "name": "Partidas pendientes de imputación", "sequence": 70, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "117" }],
          "legal_reference": "Cuenta de uso interno, sin correspondencia en un rubro propio del Código de Comercio", "source": "ccom" },
        { "code": "AC", "parent": null, "name": "Total del activo corriente", "sequence": 80, "is_total": true,
          "plus": ["CB", "INV", "CXC", "OCR", "CFI", "INVT", "PPI"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CNC", "parent": null, "name": "Créditos no corrientes", "sequence": 90, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "121" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PPE", "parent": null, "name": "Propiedad, planta y equipo", "sequence": 100, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "122" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "AIN", "parent": null, "name": "Activos intangibles", "sequence": 110, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "123" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "ANC", "parent": null, "name": "Total del activo no corriente", "sequence": 120, "is_total": true,
          "plus": ["CNC", "PPE", "AIN"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "ACT", "parent": null, "name": "Total del activo", "sequence": 130, "is_total": true,
          "plus": ["AC", "ANC"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CPC", "parent": null, "name": "Cuentas por pagar comerciales", "sequence": 140, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "211" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "REM", "parent": null, "name": "Remuneraciones y cargas sociales por pagar", "sequence": 150, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "212" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CFP", "parent": null, "name": "Cargas fiscales por pagar", "sequence": 160, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "213" }],
          "legal_reference": "Ley del IVA, art. 25 — el impuesto a pagar de un período en que el débito fiscal supera al crédito fiscal", "source": "liva" },
        { "code": "ANT", "parent": null, "name": "Anticipos de clientes", "sequence": 170, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "214" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PRO", "parent": null, "name": "Provisiones y otros pasivos corrientes", "sequence": 180, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "215" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PC", "parent": null, "name": "Total del pasivo corriente", "sequence": 190, "is_total": true,
          "plus": ["CPC", "REM", "CFP", "ANT", "PRO"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PBL", "parent": null, "name": "Préstamos bancarios a largo plazo", "sequence": 200, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "221" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "ODL", "parent": null, "name": "Otras deudas a largo plazo", "sequence": 210, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "222" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PNC", "parent": null, "name": "Total del pasivo no corriente", "sequence": 220, "is_total": true,
          "plus": ["PBL", "ODL"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "PAS", "parent": null, "name": "Total del pasivo", "sequence": 230, "is_total": true,
          "plus": ["PC", "PNC"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CAP", "parent": null, "name": "Capital social", "sequence": 240, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "31" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "RES", "parent": null, "name": "Reservas de patrimonio", "sequence": 250, "sign": -1,
          "rules": [
            { "kind": "code_prefix", "code_from": "32" },
            { "kind": "code_prefix", "code_from": "33" }
          ],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "RAA", "parent": null, "name": "Resultados acumulados de ejercicios anteriores", "sequence": 260, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "34" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "RDP", "parent": null, "name": "Resultado del periodo", "sequence": 270, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "35" }],
          "legal_reference": "Código de Comercio, art. 258, inciso d) — el Estado de superávit o aplicación de sobrantes recoge el resultado del ejercicio hasta su aplicación", "source": "ccom" },
        { "code": "PAT", "parent": null, "name": "Total del patrimonio", "sequence": 280, "is_total": true,
          "plus": ["CAP", "RES", "RAA", "RDP"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" }
      ]
    },
    {
      "code": "CR-CCOM-ER",
      "kind": "income_statement",
      "framework": "CR-CCOM",
      "name": "Estado de Ganancias y Pérdidas",
      "legal_reference": "Código de Comercio, art. 258, inciso b) — cada cierre de ejercicio fiscal se asienta en el libro de Balances el Estado de Ganancias y Pérdidas",
      "source": "ccom",
      "lines": [
        { "code": "VEN", "parent": null, "name": "Ventas netas", "sequence": 10, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "41" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "CV", "parent": null, "name": "Costo de ventas", "sequence": 20, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "51" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "RB", "parent": null, "name": "Utilidad bruta", "sequence": 30, "is_total": true,
          "plus": ["VEN"], "minus": ["CV"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "GV", "parent": null, "name": "Gastos de venta", "sequence": 40, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "52" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "GA", "parent": null, "name": "Gastos de administración", "sequence": 50, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "53" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "RO", "parent": null, "name": "Utilidad de operación", "sequence": 60, "is_total": true,
          "plus": ["RB"], "minus": ["GV", "GA"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "IFO", "parent": null, "name": "Ingresos financieros y otros ingresos", "sequence": 70, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "46" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "OTRI", "parent": null, "name": "Otros ingresos", "sequence": 80, "sign": -1,
          "rules": [{ "kind": "code_prefix", "code_from": "48" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "GFO", "parent": null, "name": "Gastos financieros y otros gastos", "sequence": 90, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "56" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "OTRE", "parent": null, "name": "Otros gastos", "sequence": 100, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "58" }],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "UAI", "parent": null, "name": "Utilidad antes de impuesto sobre la renta", "sequence": 110, "is_total": true,
          "plus": ["RO", "IFO", "OTRI"], "minus": ["GFO", "OTRE"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" },
        { "code": "ISR", "parent": null, "name": "Impuesto sobre la renta", "sequence": 120, "sign": 1,
          "rules": [{ "kind": "code_prefix", "code_from": "57" }],
          "legal_reference": "Ley del Impuesto sobre la Renta — no modelada por este paquete; la cuenta existe para que el estado de resultados la presente cuando la empresa la liquide manualmente. Ver README.md", "source": "ccom" },
        { "code": "UN", "parent": null, "name": "Utilidad neta del periodo", "sequence": 130, "is_total": true,
          "plus": ["UAI"], "minus": ["ISR"],
          "legal_reference": "Código de Comercio, art. 258", "source": "ccom" }
      ]
    }
  ]
}
