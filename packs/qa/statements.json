{
  "$schema": "https://ekwo.ai/schemas/pack/1.json#/$defs/statements",
  "inherit": "IFRS-SME",
  "statements": [
    {
      "code": "QA-IFRS-SFP",
      "kind": "balance_sheet",
      "framework": "IFRS",
      "name": "Statement of financial position",
      "legal_reference": "Qatar's Income Tax Law (Law No. 24 of 2018), article 12, requires books and records kept in accordance with the laws of the State and international accounting standards, and article 6 requires accrual accounting in accordance with international accounting standards; the Commercial Companies Law (Law No. 11 of 2015), article 182, gives a company a twelve-month financial year and article 183 has the board submit the balance sheet, profit and loss account and activity report to the auditor each year. This pack's research did not open a Qatari text prescribing a statement layout, and did not verify which IFRS regime (full IFRS Accounting Standards or IFRS for SMEs) Qatari non-listed companies apply. The lines follow the minimum line items of IAS 1 Presentation of Financial Statements, paragraph 54, with current and non-current assets and liabilities presented separately (paragraph 60); the numbering and the account ranges are original to this pack. This is the first thing a local reviewer should check.",
      "result_in_progress": "alone",
      "source": "income-tax-law"
    },
    {
      "code": "QA-IFRS-IS",
      "kind": "income_statement",
      "framework": "IFRS",
      "name": "Statement of profit or loss",
      "legal_reference": "Presented as a separate statement of profit or loss, with expenses classified by function in outline (cost of sales, then operating expenses) in the manner of IAS 1 paragraphs 81A and 99-103, as the Income Tax Law (Law No. 24 of 2018), articles 6 and 12, point to international accounting standards without prescribing a layout. Other comprehensive income is not modelled: no revaluation or similar account is carried, so the profit for the year is the whole result. IFRS 18, which replaces IAS 1 for annual periods beginning on or after 1 January 2027, is not modelled. The numbering is original to this pack.",
      "source": "income-tax-law"
    }
  ],
  "overrides": [
    {
      "statement": "QA-IFRS-SFP",
      "line": "A-NC-FIX",
      "name": "Property, plant and equipment"
    },
    {
      "statement": "QA-IFRS-SFP",
      "add": {
        "code": "A-NC-INT",
        "parent": "A-NC",
        "name": "Goodwill and other intangible assets",
        "sequence": 15,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1800",
            "code_to": "1899"
          }
        ]
      }
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "A-NC",
      "plus": [
        "A-NC-FIX",
        "A-NC-INT",
        "A-NC-OTH"
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "A-C-REC",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1100",
          "code_to": "1199"
        }
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "add": {
        "code": "A-C-INV",
        "parent": "A-C",
        "name": "Inventories",
        "sequence": 45,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1200",
            "code_to": "1299"
          }
        ]
      }
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "A-C-OTH",
      "name": "Other current assets",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "1300",
          "code_to": "1399"
        }
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "add": {
        "code": "A-C-PRE",
        "parent": "A-C",
        "name": "Prepayments and deposits paid",
        "sequence": 55,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "1400",
            "code_to": "1499"
          }
        ]
      }
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "A-C",
      "plus": [
        "A-C-REC",
        "A-C-INV",
        "A-C-OTH",
        "A-C-PRE",
        "A-C-CASH"
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "E-CAP",
      "name": "Share capital and reserves"
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "E-RESULT",
      "name": "Profit for the year"
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "L-C-PAY",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2000",
          "code_to": "2059"
        }
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "add": {
        "code": "L-C-TAX",
        "parent": "L-C",
        "name": "Current tax liabilities",
        "sequence": 135,
        "sign": -1,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "2060",
            "code_to": "2069"
          }
        ]
      }
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "L-C-OTH",
      "rules": [
        {
          "kind": "code_range",
          "code_from": "2070",
          "code_to": "2099",
          "sequence": 10
        },
        {
          "kind": "code_range",
          "code_from": "2200",
          "code_to": "2299",
          "sequence": 20
        }
      ]
    },
    {
      "statement": "QA-IFRS-SFP",
      "line": "L-C",
      "plus": [
        "L-C-PAY",
        "L-C-TAX",
        "L-C-OTH"
      ]
    },
    {
      "statement": "QA-IFRS-IS",
      "line": "OPEX",
      "name": "Administrative and other operating expenses"
    },
    {
      "statement": "QA-IFRS-IS",
      "add": {
        "code": "PBT",
        "name": "Profit (loss) before tax",
        "sequence": 65,
        "is_total": true,
        "plus": [
          "GROSS",
          "OTH-INC"
        ],
        "minus": [
          "OPEX",
          "DEPR"
        ]
      }
    },
    {
      "statement": "QA-IFRS-IS",
      "add": {
        "code": "TAX",
        "name": "Income tax expense",
        "sequence": 67,
        "rules": [
          {
            "kind": "code_range",
            "code_from": "6470",
            "code_to": "6474",
            "sequence": 10
          },
          {
            "kind": "account_code",
            "code_from": "6480",
            "sequence": 20
          }
        ]
      }
    },
    {
      "statement": "QA-IFRS-IS",
      "line": "PROFIT",
      "name": "Profit (loss) for the year",
      "plus": [
        "PBT"
      ],
      "minus": [
        "TAX"
      ]
    }
  ]
