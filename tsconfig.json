{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@ekwo-ai/core": ["./packages/core/src/index.ts"],
      "@ekwo-ai/fec": ["./packages/formats/fec/src/index.ts"],
      "@ekwo-ai/xbrl-cbso": ["./packages/formats/xbrl-cbso/src/index.ts"],
      "@ekwo-ai/intra-consignment": ["./packages/formats/intra-consignment/src/index.ts"],
      "@ekwo-ai/des": ["./packages/formats/des/src/index.ts"],
      "@ekwo-ai/ecdf": ["./packages/formats/ecdf/src/index.ts"],
      "@ekwo-ai/vd": ["./packages/formats/vd/src/index.ts"],
      "@ekwo-ai/vat-consignment": ["./packages/formats/vat-consignment/src/index.ts"],
      "@ekwo-ai/peppol-ubl": ["./packages/formats/peppol-ubl/src/index.ts"],
      "@ekwo-ai/camt053": ["./packages/formats/camt053/src/index.ts"],
      "@ekwo-ai/coda": ["./packages/formats/coda/src/index.ts"],
      "@ekwo-ai/cfonb120": ["./packages/formats/cfonb120/src/index.ts"],
      "@ekwo-ai/trial-balance": ["./packages/formats/trial-balance/src/index.ts"],
      "@ekwo-ai/journal-items": ["./packages/formats/journal-items/src/index.ts"],
      "@ekwo-ai/journal-report": ["./packages/formats/journal-report/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/formats/*/src",
    "packages/formats/*/test",
    "modules/*/tests",
    "tests",
    "scripts"
  ]
}
